import { ScrollView, TextEdit, LineEdit } from "std-widgets.slint";
import { Theme, Backdrop, Background, Box, BoxKind, Icons, Label, Glass, GlassKind, GlassButton, Icon, IconButton, ProgressRing, Spinner, TextStyle } from "theme.slint";

// Rust fills it with the blurred window behind an overlay.
export { Backdrop, Theme } from "theme.slint";

// Discovered LAN peer
export struct DiscoveredPeer {
    name: string,
    addr: string,
}

// Saved contact from address book
export struct ContactInfo {
    name: string,
    fingerprint: string,
    online: bool,
    auto_connect: bool,
}

// File info model for dynamic file list
export struct FileInfo {
    name: string,         // full name: Open, Save, Pause and X act on it
    label: string,        // what the card shows: the name inside the open folder
    size-bytes: int,
    downloading: bool,    // I'm downloading this file
    uploading: bool,      // peer is downloading this file from me
    progress: float,      // 0.0 to 1.0
    saved: bool,
    paused: bool,         // download was paused (can resume)
    file-type: string,    // "pdf", "image", "video", "audio", "code", "archive", "text", "other"
    is-local: bool,       // true = my file (shared by me), false = remote file (from peer)
    viewable: bool,       // the browser build opens it in its player; the desktop leaves it false
}

// One row of the header's "..." menu.
export struct MenuEntry {
    id: string,
    label: string,
    a11y: string,
}

// Numbered step square (Figma NEW 2.0).
component Badge inherits Box {
    in property <int> number;
    kind: BoxKind.badge;
    width: 39.65px;
    height: 39.65px;

    Label {
        x: 0.5px;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        style: Theme.step;
        color: Theme.step-ink;
        text: root.number;
    }
}

// Text that acts as a button. pad widens the hit area past the glyphs.
component TextAction inherits Rectangle {
    in property <string> text;
    in property <TextStyle> style: Theme.small;
    in property <color> ink: Theme.muted;
    in property <color> hover-ink: Theme.text;
    in property <length> pad: 0;
    callback clicked;

    width: label.preferred-width + 2 * root.pad;
    height: 20px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    label := Label {
        x: root.pad;
        height: parent.height;
        silent: true;
        style: root.style;
        text: root.text;
        color: touch.has-hover || touch.pressed ? root.hover-ink : root.ink;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A code in her field with its grey buttons at the end (Figma NEW 2.0): the
// buttons sit on the field's last button-width. They are the children, placed
// in that slot.
component Field inherits Box {
    in-out property <string> text;
    in property <bool> read-only;
    in property <length> button-width: 195.35px;
    callback accepted;

    kind: BoxKind.field;
    height: Theme.field-height;

    Rectangle {
        x: 17.45px;
        width: root.width - root.button-width - 21px;
        height: root.height;
        clip: true;

        if root.read-only: Label {
            width: parent.width;
            height: parent.height;
            style: Theme.field-text;
            color: Theme.text-soft;
            overflow: elide;
            text: root.text;
        }
        if !root.read-only: TextInput {
            width: parent.width;
            height: parent.height;
            font-size: Theme.field-text.size;
            font-weight: Theme.field-text.weight;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            text <=> root.text;
            accepted => { root.accepted(); }
        }
    }
    Rectangle {
        x: root.width - root.button-width;
        width: root.button-width;
        height: root.height;
        @children
    }
}

// One of a field's grey buttons (Figma NEW 2.0). Add is a shade lighter and
// its label a size larger than Copy and Invite link (dim).
component FieldAction inherits Box {
    in property <string> text;
    in property <bool> dim: false;
    // Her Copy sits half a pixel left of its button's centre.
    in property <length> nudge: 0;
    callback clicked;

    kind: root.dim ? BoxKind.button-dim : BoxKind.button;
    x: 0;
    y: 0;
    height: Theme.field-height;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        background: touch.pressed ? #0000001f : touch.has-hover ? #ffffff0d : transparent;
        animate background { duration: 150ms; }
    }
    Label {
        x: root.nudge;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        silent: true;
        style: root.dim ? Theme.field-button-small : Theme.field-button;
        // White while pressed, the cue every button gives.
        color: touch.pressed ? Theme.text : Theme.text-strong;
        text: root.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Switch (Figma Screen 12): grey glass with a grey knob when off, blue glass
// with a blue knob on the right when on.
component ToggleSwitch inherits Glass {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    kind: GlassKind.track;
    tint: root.checked ? Theme.switch-on : Theme.switch-off;
    width: 36px;
    height: 20px;

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius-small;
        background: root.checked ? Theme.knob-on : Theme.knob-off;
        animate x { duration: 150ms; easing: ease-out; }
        animate background { duration: 150ms; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Switch with its label to the right (Figma NEW 2.0): the label is light on
// and off, the knob shows the state.
component ToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 20px;

    ToggleSwitch {
        x: 0;
        y: 0;
        accessible-label: root.text;
        checked <=> root.checked;
        enabled: root.enabled;
        toggled(v) => { root.toggled(v); }
    }
    // Her label box: 51.81px right of the track, a hair under its top.
    Label {
        x: 51.81px;
        y: 0.92px;
        height: 15px;
        silent: true;
        style: Theme.switch-label;
        color: Theme.switch-ink;
        text: root.text;
    }
}

// Her Connect, two states: at rest a blue line and a blue label (her nearby
// device rows), pressed or busy filled blue with a white label (Figma NEW
// 2.0). plain: a grey one for the second choice (Cancel, No thanks, Quit).
component PillButton inherits Box {
    in-out property <string> text: "Button";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> plain: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    property <bool> lit: root.active || pill-touch.pressed;

    kind: root.plain ? BoxKind.button-dim : root.lit ? BoxKind.primary : BoxKind.highlight;
    width: 161px;
    height: Theme.button-height;
    opacity: root.enabled || root.active ? 1 : 0.4;

    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        background: root.plain
            ? (pill-touch.pressed ? #0000001f : pill-touch.has-hover ? #ffffff0d : transparent)
            : !root.lit && pill-touch.has-hover ? #177cf31a : transparent;
        animate background { duration: 150ms; }
    }
    // Figma draws her label a pixel right of and half a pixel under the centre.
    Label {
        x: 1px;
        y: 0.5px;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        silent: true;
        style: Theme.primary;
        color: root.lit ? Theme.text : root.plain ? Theme.text-strong : Theme.accent;
        text: root.text;
    }

    pill-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small grey button (Figma NEW 2.0 colors): Buy relay credit, Not now, the
// overlays' X.
component SmallOutlineButton inherits Box {
    in-out property <string> text: "?";
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    kind: BoxKind.button-dim;
    radius: Theme.radius;
    width: self.preferred-width;
    preferred-width: btn-label.preferred-width + 28px;
    height: 24px;

    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        background: small-touch.pressed ? #0000001f : small-touch.has-hover ? #ffffff0d : transparent;
        animate background { duration: 150ms; }
    }
    btn-label := Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        silent: true;
        style: Theme.caption;
        color: small-touch.pressed ? Theme.text : Theme.text-strong;
        text: root.text;
    }

    small-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component KeibiDropLogo inherits Rectangle {
    width: 195px;
    height: 24px;
    accessible-role: image;
    accessible-label: "KEIBIDROP";

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/logo.svg");
        image-fit: contain;
    }
}

// A file card's action (Figma 214:988 in the NEW 2.0 colors): a grey button,
// or with accent her highlighted line and blue label (Open).
component OutlineButton inherits Box {
    in-out property <string> text: "Button";
    in property <bool> enabled: true;
    in property <bool> accent: false;
    in property <TextStyle> style: Theme.button-label;
    in property <color> accent-ink: Theme.accent;
    out property <bool> hovered: touch.has-hover;
    callback clicked;

    kind: root.accent && root.enabled ? BoxKind.highlight : BoxKind.button-dim;
    radius: Theme.radius;
    width: 161px;
    height: Theme.control;

    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        background: touch.pressed ? #ffffff14 : touch.has-hover ? #ffffff0a : transparent;
        animate background { duration: 150ms; }
    }
    Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        style: root.style;
        color: !root.enabled ? Theme.faint : touch.pressed ? Theme.text : root.accent ? root.accent-ink : Theme.text-strong;
        text: root.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One saved contact (Figma NEW 2.0): status dot, name, code, Auto, Connect.
// Remove shows on hover only, so the row matches the design at rest.
component ContactRow inherits Rectangle {
    in property <ContactInfo> contact;
    // The browser build: a tab cannot reconnect on its own, so no Auto.
    in property <bool> web: false;
    // Her line between rows, along the top of every row but the first.
    in property <bool> first: true;
    callback connect;
    callback auto;
    callback remove;

    height: 34.15px;

    hover := TouchArea { }
    if !root.first: Rectangle {
        x: 0;
        y: -Theme.line / 2;
        width: parent.width;
        height: Theme.line;
        background: Theme.row-divider;
    }
    Rectangle {
        x: 22.77px;
        y: (parent.height - self.height) / 2;
        width: 9.42px;
        height: 9.42px;
        border-radius: self.width / 2;
        background: root.contact.online ? Theme.online : Theme.offline;
    }
    Label {
        x: 66.74px;
        width: 105px;
        height: parent.height;
        overflow: elide;
        style: Theme.row;
        color: Theme.text-strong;
        text: root.contact.name;
    }
    Label {
        x: 178.23px;
        width: 191px;
        height: parent.height;
        overflow: elide;
        style: Theme.row;
        color: Theme.muted;
        text: root.contact.fingerprint;
    }
    if !root.web: TextAction {
        x: 375.3px;
        y: (parent.height - self.height) / 2;
        style: Theme.row;
        text: "Auto";
        accessible-label: "Auto connect " + root.contact.name;
        ink: root.contact.auto_connect ? Theme.link : Theme.muted;
        clicked => { root.auto(); }
    }
    TextAction {
        x: 461.67px;
        y: (parent.height - self.height) / 2;
        style: Theme.row;
        text: "Connect";
        accessible-label: "Connect to " + root.contact.name;
        ink: Theme.link;
        clicked => { root.connect(); }
    }
    remove-action := TextAction {
        x: 521px;
        y: (parent.height - self.height) / 2;
        pad: 4px;
        style: Theme.row;
        text: "X";
        accessible-label: "Remove " + root.contact.name;
        ink: hover.has-hover ? Theme.muted : transparent;
        hover-ink: Theme.error;
        clicked => { root.remove(); }
    }
}

// Her scroll thumb (Screen 12 contacts), shown while a list has more.
component ScrollThumb inherits Rectangle {
    width: 6.77px;
    height: 30px;
    border-radius: Theme.radius-small;
    background: Theme.scrollbar;
}

// Saved contacts in her list (Figma NEW 2.0): rows 34.15px apart with a line
// between them. Three rows show, the rest scroll.
component ContactsPanel inherits Box {
    in property <[ContactInfo]> contacts;
    in property <bool> web: false;
    callback connect(int);
    callback auto(int);
    callback remove(int);

    property <length> pitch: 34.15px;
    property <length> top: 4px;

    kind: BoxKind.list;

    list := Flickable {
        x: 0;
        y: root.top;
        width: parent.width;
        height: 3 * root.pitch;
        content-height: max(self.height, root.contacts.length * root.pitch);

        for contact[i] in root.contacts: ContactRow {
            x: 0;
            y: i * root.pitch;
            width: root.width;
            first: i == 0;
            contact: contact;
            web: root.web;
            connect => { root.connect(i); }
            auto => { root.auto(i); }
            remove => { root.remove(i); }
        }
    }
    if list.content-height > list.height: ScrollThumb {
        x: root.width - 14px;
        y: 9px + (root.height - 48px) * (-list.content-y / (list.content-height - list.height));
    }
}

// One row of the header's "..." menu (Figma NEW 2.0): white, blue on hover,
// her chevron at the end and her line above every row but the first.
component MenuItem inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> first: true;
    callback clicked;

    property <color> ink: touch.has-hover || touch.pressed ? Theme.link : Theme.text;

    height: Theme.menu-row;
    accessible-role: button;
    accessible-label: root.entry.a11y;
    accessible-action-default => { root.clicked(); }

    if !root.first: Rectangle {
        x: 17px;
        y: 0.6px - Theme.line / 2;
        width: 168px;
        height: Theme.line;
        background: Theme.divider;
    }
    Label {
        x: 16.92px;
        y: 6.48px;
        height: 14px;
        silent: true;
        style: Theme.menu;
        color: root.ink;
        text: root.entry.label;
    }
    Icon {
        x: 180px;
        y: 8.56px;
        width: 4px;
        height: 8px;
        icon: Icons.chevron;
        ink: root.ink;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A nearby device in local mode (Figma 273:1324): her highlighted row with
// the name, a blue line and Connect. The whole row connects.
component DeviceRow inherits Box {
    in property <string> name;
    callback clicked;

    kind: BoxKind.highlight;
    height: 39px;
    accessible-role: button;
    accessible-label: "Connect to " + root.name;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: root.outer-radius;
        background: touch.pressed ? #177cf333 : touch.has-hover ? #177cf31a : transparent;
        animate background { duration: 150ms; }
    }
    Label {
        x: 18.5px;
        y: 11.5px;
        width: 88px;
        height: 17px;
        overflow: elide;
        silent: true;
        style: Theme.device;
        text: root.name;
    }
    Rectangle {
        x: 112px - Theme.line / 2;
        y: 10px;
        width: Theme.line;
        height: 19px;
        background: Theme.accent;
    }
    Label {
        x: 125px;
        y: 11.5px;
        width: 59px;
        height: 17px;
        horizontal-alignment: center;
        silent: true;
        style: Theme.device-action;
        // White while pressed, the cue every button gives.
        color: touch.pressed ? Theme.text : Theme.accent;
        text: "Connect";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Full-window overlay (Figma Screen 13): the window blurred behind, a sharp
// title, and a frosted glass card that holds the children.
component Overlay inherits Rectangle {
    in property <string> heading;
    in property <string> heading-light;
    in property <string> subheading;
    in property <length> card-x: 313px;
    in property <length> card-y: 260px;
    in property <length> card-width: 517px;
    in property <length> card-height: 420px;
    callback dismiss;

    property <float> alpha: 0;
    opacity: root.alpha;
    animate opacity { duration: 220ms; easing: ease-out; }
    init => { root.alpha = 1; }

    Rectangle { background: Theme.window-dim; }
    Image {
        width: parent.width;
        height: parent.height;
        source: Backdrop.blur;
        image-fit: fill;
    }
    Rectangle { background: Theme.glass-tint; }
    TouchArea { clicked => { root.dismiss(); } }

    // Figma draws her titles half a pixel up from their boxes (her 2x render).
    if root.heading != "": HorizontalLayout {
        x: 2px;
        y: 149.5px;
        width: parent.width;
        height: 30px;
        alignment: center;
        Label { style: Theme.title-wide; text: root.heading; }
        if root.heading-light != "": Label { style: Theme.title-light; text: root.heading-light; }
    }
    if root.subheading != "": Label {
        x: -0.5px;
        y: 185px;
        width: parent.width;
        height: 30px;
        horizontal-alignment: center;
        style: Theme.subtitle;
        text: root.subheading;
    }
    Glass {
        x: root.card-x;
        y: root.card-y;
        width: root.card-width;
        height: root.card-height;
        kind: GlassKind.card;
        frosted: true;
        // Clicks on the card stay on the card.
        TouchArea { }
        @children
    }
}

// The (+) of the no-FUSE screen (Figma 214:988): her blue plus in her ring,
// which stays as a static circle; its arc turns while files are dragged over
// the window or dropped ones are added and goes at the end of the
// turn it is in. A click picks files.
component AddRing inherits Rectangle {
    in property <bool> spinning;
    callback clicked;

    width: 135.59px;
    height: 137px;
    accessible-role: button;
    accessible-label: "Add files";
    accessible-action-default => { root.clicked(); }

    Spinner {
        width: root.width;
        height: root.height;
        radius-x: 49.5575px;
        radius-y: 50.0735px;
        thickness: 8px;
        active: root.spinning;
        arc-at-rest: false;
    }
    // Her plus: 43px across, 8px round strokes, centred on the ring.
    Path {
        width: root.width;
        height: root.height;
        fit: preserve;
        commands: "M 46 68.5 L 89 68.5 M 67.5 47 L 67.5 90";
        stroke: touch.pressed ? Theme.text : touch.has-hover ? Theme.progress : Theme.open-ink;
        stroke-width: 8px;
        stroke-line-cap: round;
        fill: transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Her folder (Figma Screen 14): a tab behind a body, her gradients. Folder
// cards show it too.
component FolderIcon inherits Image {
    width: 80px;
    height: 62px;
    source: @image-url("../assets/folder.svg");
}

// What a file is, in the middle of its preview.
component FileTypeIcon inherits Label {
    in property <string> file-type: "other";

    horizontal-alignment: center;
    style: Theme.heading-medium;
    color: Theme.muted;
    text: root.file-type == "pdf" ? "PDF"
        : root.file-type == "image" ? "IMG"
        : root.file-type == "video" ? "VID"
        : root.file-type == "audio" ? "SND"
        : root.file-type == "code" ? "</>"
        : root.file-type == "archive" ? "ZIP"
        : root.file-type == "text" ? "TXT"
        : "FILE";
}

// One file (Figma 214:988): a grey preview, then a square, the name and the
// action. While it downloads the square is its progress ring and the
// action shows the percent: Pause on hover, Resume once paused; once saved the
// square holds a check. A file that can go (yours, or a saved one) ends the
// row with X.
component FileCard inherits Rectangle {
    in property <string> filename: "";
    in property <string> file-type: "other";
    in property <bool> downloading: false;
    in property <float> progress: 0.0;
    in property <bool> saved: false;
    in property <bool> is-local: false;
    in property <bool> paused: false;
    in property <length> preview-height: 116px;
    // The browser build: its player opens what it can show, and it cannot
    // unshare, so its own files have no X.
    in property <bool> web: false;
    in property <bool> viewable: false;

    callback save-clicked;
    callback open-clicked;
    callback pause-clicked;
    callback delete-clicked;

    // Her card: the preview, the row 11px under it, 24px tall.
    property <length> row-y: root.preview-height + 11px;
    property <bool> removable: root.is-local && !root.web;
    // Open plays or shows it in the browser; the small button beside it saves.
    property <bool> web-view: root.web && root.viewable && !root.is-local && !root.saved
        && !root.downloading && !root.paused;

    width: 214px;
    height: self.row-y + 24px;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.preview-height;
        border-radius: Theme.radius;
        background: Theme.file-preview;

        if root.file-type == "folder": FolderIcon {
            x: round((parent.width - self.width) / 2px) * 1px;
            y: round((parent.height - self.height) / 2px) * 1px;
        }
        if root.file-type != "folder": FileTypeIcon {
            width: parent.width;
            height: parent.height;
            file-type: root.file-type;
        }
    }

    // Her small ring (18px, 5px stroke) in the 24px square's place.
    if root.downloading || root.paused: ProgressRing {
        x: 0;
        y: root.row-y;
        width: 24px;
        height: 24px;
        progress: root.progress;
    }
    if !(root.downloading || root.paused): Box {
        kind: BoxKind.badge;
        radius: Theme.radius;
        x: 0;
        y: root.row-y;
        width: 24px;
        height: 24px;

        if root.saved: Path {
            width: parent.width;
            height: parent.height;
            fit: preserve;
            commands: "M 7 12.5 L 10.5 16 L 17 8.5";
            stroke: Theme.text;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }
    name := Label {
        x: 34px;
        y: root.row-y;
        width: action.x - 6px - self.x;
        height: 24px;
        style: Theme.badge;
        overflow: elide;
        text: root.filename;
    }
    name-hover := TouchArea {
        x: name.x;
        y: name.y;
        width: name.width;
        height: name.height;
    }
    // Her action is 110px wide; with X the two share those 110px.
    action := OutlineButton {
        x: root.width - 110px;
        y: root.row-y;
        width: root.removable || root.web-view ? 80px : 110px;
        height: 24px;
        style: Theme.button-small;
        enabled: !(root.web && root.is-local);
        accent: root.is-local || root.saved || root.web-view;
        accent-ink: Theme.open-ink;
        text: root.file-type == "folder" ? "Open"
            : root.downloading ? (self.hovered ? "Pause" : Math.round(root.progress * 100) + "%")
            : root.paused ? "Resume"
            : root.web && root.is-local ? "Shared"
            : root.is-local || root.saved || root.web-view ? "Open"
            : "Save";
        clicked => {
            if (root.file-type == "folder") {
                root.open-clicked();
            } else if (root.downloading) {
                root.pause-clicked();
            } else if (root.paused || !(root.is-local || root.saved || root.web-view)) {
                // Save, or Resume: the download picks up where it stopped.
                root.save-clicked();
            } else {
                root.open-clicked();
            }
        }
    }
    if root.removable: SmallOutlineButton {
        x: root.width - 24px;
        y: root.row-y;
        width: 24px;
        text: "X";
        clicked => { root.delete-clicked(); }
    }
    if root.web-view: SmallOutlineButton {
        x: root.width - 24px;
        y: root.row-y;
        width: 24px;
        text: "\u{2193}";
        accessible-label: "Save";
        clicked => { root.save-clicked(); }
    }
    // A name cut short shows whole above its row while the pointer is on it.
    if name-hover.has-hover && name.preferred-width > name.width: Rectangle {
        x: 0;
        y: root.row-y - 8px - self.height;
        width: root.width;
        height: full.preferred-height + 12px;
        border-radius: Theme.radius;
        background: Theme.card;

        full := Label {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            style: Theme.badge;
            wrap: word-wrap;
            text: root.filename;
        }
    }
}

// Her file grid (Figma 214:988): four columns that scroll. It fills the box,
// so there is no thumb: her frame shows the next row cut by the window.
component FileGrid inherits Rectangle {
    in property <[FileInfo]> files;
    // Saved Files: every file is saved, opens and can go.
    in property <bool> browse-mode: false;
    in property <bool> web: false;
    in property <length> card-width: 214.25px;
    in property <length> gap: 19px;
    in property <length> preview-height: 116px;
    in property <length> row-pitch: 183px;
    callback open(FileInfo);
    callback save(string);
    callback pause(string);
    callback remove(string);

    property <int> columns: 4;
    // Only the rows in view, and the one coming into view, have cards: a
    // folder of 12,789 files costs a screenful, and scrolling hands the same
    // cards to the next files.
    property <int> first-row: max(0, floor(-list.content-y / root.row-pitch));
    property <int> rows-shown: ceil(root.height / root.row-pitch) + 1;
    property <int> first: root.first-row * root.columns;

    list := Flickable {
        width: root.width;
        height: root.height;
        content-height: max(self.height, Math.ceil(root.files.length / root.columns) * root.row-pitch);

        for slot in max(0, min(root.rows-shown * root.columns, root.files.length - root.first)): FileCard {
            property <int> idx: root.first + slot;
            property <FileInfo> file: root.files[self.idx];
            // Whole pixels as in her frame: 214, 215, 215, 214 wide.
            property <float> left: mod(self.idx, root.columns) * (root.card-width + root.gap) / 1px;
            x: floor(self.left + 0.25) * 1px;
            y: floor(self.idx / root.columns) * root.row-pitch;
            width: ceil(self.left + root.card-width / 1px - 0.25) * 1px - self.x;
            preview-height: root.preview-height;
            filename: file.label;
            file-type: file.file-type;
            downloading: !root.browse-mode && file.downloading;
            progress: file.progress;
            saved: root.browse-mode || file.saved;
            is-local: (root.browse-mode && !root.web) || file.is-local;
            paused: !root.browse-mode && file.paused;
            web: root.web;
            viewable: file.viewable;
            open-clicked => { root.open(self.file); }
            save-clicked => { root.save(self.file.name); }
            pause-clicked => { root.pause(self.file.name); }
            delete-clicked => { root.remove(self.file.name); }
        }
    }
}

// Inside a folder (Figma 214:988): her glass "< Back" pill, then the
// folder's name.
component FolderBar inherits Rectangle {
    in property <string> folder;
    // Muted text after the name, such as a count.
    in property <string> note;
    callback back;

    height: 24px;

    GlassButton {
        x: 0;
        y: 0;
        width: 101px;
        text: "< Back";
        clicked => { root.back(); }
    }
    title := Label {
        x: 114px;
        y: 0;
        width: min(self.preferred-width, root.width - self.x);
        height: 24px;
        style: Theme.section;
        overflow: elide;
        text: root.folder;
    }
    if root.note != "": Label {
        x: title.x + title.width + 12px;
        y: 0;
        height: 24px;
        style: Theme.label;
        color: Theme.muted;
        text: root.note;
    }
}

// One of Teleport's four points (Figma Screen 14): her icon, then two grey
// lines.
component TeleportPoint inherits Rectangle {
    in property <string> icon;
    in property <length> icon-width;
    in property <length> icon-height;
    in property <length> icon-y: 0;
    // Where the lines start, from the icon's left edge.
    in property <length> text-x;
    in property <string> text;

    width: self.text-x + 79px;
    height: 23px;

    Icon {
        x: 0;
        y: root.icon-y;
        width: root.icon-width;
        height: root.icon-height;
        icon: root.icon;
    }
    Label {
        x: root.text-x;
        y: 1.5px;
        height: 20px;
        vertical-alignment: top;
        style: Theme.tiny;
        color: Theme.muted;
        text: root.text;
    }
}

// A glass tag on the connection line: the path, or the relay credit offer.
// Her chip (Figma NEW 2.0 "Via Relay") is a switch's glass.
component Chip inherits Glass {
    in property <string> text;
    in property <color> ink: Theme.chip-ink;
    in property <bool> clickable: false;
    callback clicked;

    kind: GlassKind.track;
    tint: Theme.switch-off;
    width: chip-label.preferred-width + 26px;
    height: 20px;

    chip-label := Label {
        x: 13px;
        height: root.height;
        style: Theme.chip;
        color: chip-touch.pressed ? Theme.text : root.ink;
        text: root.text;
    }
    chip-touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Under the logo of a connected screen: the state, path, relay credit and
// speed.
component ConnectionLine inherits HorizontalLayout {
    in property <string> state;
    in property <string> state-text;
    in property <string> throughput;
    in property <string> mode;
    in property <bool> funded;
    in property <string> credit;
    in property <bool> offer-credit: true;
    callback buy;

    property <color> ink: root.state == "connected" || root.state == "" ? Theme.online
        : root.state == "gave_up" || root.state == "mount_failed" ? Theme.error
        : Theme.muted;

    height: 22px;
    spacing: 8px;
    alignment: start;

    Rectangle {
        width: 8px;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: root.ink;
    }
    Label {
        style: Theme.label;
        color: root.ink;
        text: root.state-text != "" ? root.state-text : "Connected";
    }
    if root.mode != "": Chip {
        y: (parent.height - self.height) / 2;
        ink: root.mode == "lan" ? Theme.online
            : root.mode == "direct" || root.mode == "direct-out" ? Theme.accent
            : Theme.chip-ink;
        text: root.mode == "lan" ? "LAN"
            : root.mode == "direct" ? "Direct P2P"
            : root.mode == "direct-out" ? "Direct reads"
            : root.mode == "direct-in" ? "Direct for friend"
            : root.mode == "bridge" ? "Via Relay"
            : root.mode;
    }
    // Relay credit: offer the buy page while unfunded, show balance when funded.
    if root.mode == "bridge" && !root.funded && root.offer-credit: Chip {
        y: (parent.height - self.height) / 2;
        ink: Theme.accent;
        clickable: true;
        text: "Get relay credit";
        clicked => { root.buy(); }
    }
    if root.mode == "bridge" && root.funded && root.credit != "": Label {
        style: Theme.caption;
        color: Theme.faint;
        text: root.credit;
    }
    // The speed comes and goes with transfers, so it goes last: nothing
    // before it moves when it appears.
    if root.throughput != "": Label {
        style: Theme.caption;
        color: Theme.faint;
        text: root.throughput;
    }
}

export component MainWindow inherits Window {
    title: root.window_title;
    // KD_WINDOW_TITLE names the window when two instances run side by side.
    in property<string> window_title: "KEIBIDROP";
    default-font-family: "Inter";
    // The whole UI scales with the window (main.rs first_size, fit_zoom), in
    // the design's proportions. zoom is that factor, Theme.zoom-min at the least.
    in property <float> zoom: 1;
    preferred-width: Theme.frame-width * Theme.zoom-open / root.zoom;
    preferred-height: Theme.frame-height * Theme.zoom-open / root.zoom;
    min-width: Theme.frame-width * Theme.zoom-min / root.zoom;
    min-height: Theme.frame-height * Theme.zoom-min / root.zoom;
    background: root.capturing ? Theme.window-dim : Theme.window;

    // Every screen and the header sit in the Figma frame's column, centred
    // when the window is wider, so the menu pill keeps its place everywhere.
    property <length> column-x: max(0px, (root.width - Theme.frame-width) / 2);

    // Data bindings from Rust
    in property<string> my_code: "";
    in-out property<string> peer_code: "";
    in property<bool> next_enabled: true;

    // Screen state: 0 = connect, 1 = connected (no-fuse), 2 = connected (fuse)
    in-out property<int> current_screen: 0;

    // Error message (shown on connect screen)
    in-out property<string> error_message: "";

    // Room action state: 0=none, 1=creating, 2=joining
    in-out property<int> room_action: 0;
    // Status message (shown below buttons on connect screen)
    in-out property<string> status_message: "";

    // Dynamic file list model (populated by Rust file watcher)
    in-out property<[FileInfo]> file_list: [];
    // Current folder path for navigation (empty = root)
    in-out property<string> current_folder: "";
    callback navigate_folder(string);
    callback back_folder();
    // Set by Rust when any file is actively downloading
    in-out property<bool> any_downloading: false;
    // Set by Rust when a file is being dragged over the window
    in-out property<bool> drag_hovering: false;
    // Set by Rust while dropped or picked files are added (main.rs AddingFiles)
    in-out property<bool> adding_files: false;
    // Mount path for FUSE mode (Screen 2)
    in property<string> mount_path: "";
    in property<string> connection_mode: ""; // "lan", "direct", "bridge", "direct-out" (our reads direct), "direct-in" (the peer's reads direct)
    // Toast message (brief feedback shown at bottom-center, auto-hides)
    in-out property<string> toast_message: "";
    // Peer code feedback: set by Rust after KD_AddPeerFingerprint
    in-out property<bool> peer_code_added: false;
    in-out property<bool> peer_code_error: false;
    in property<string> connect_status: "";
    // Live session state from the engine, polled every second: the state for
    // logic, the sentence for people, the rate. Same words as kd status.
    in-out property<string> session_state: "";
    in-out property<string> session_state_text: "";
    in-out property<string> throughput_text: "";
    // The engine could not start: shown in place of the code, with Retry and Quit.
    in-out property<string> engine_error: "";
    callback engine_retry();
    callback engine_quit();
    // Version string from Go (set by Rust at init)
    in property<string> version_text: "";
    // Newer released version, set by Rust when the update check finds one
    in property<string> update_available: "";
    callback open_update_page();
    // FUSE mode toggle (can be changed before connecting)
    // The browser build (KeibiDropWeb web/slint-ui) sets it: no Local mode,
    // Teleport, auto-connect, log files or desktop settings there.
    in property<bool> web: false;
    // Its Settings rows: the save folder, notifications, relay and bridge.
    in property<string> web_dest: "";         // folder name, "" = ask each time
    in property<string> web_dest_action: "";  // Choose folder, Change, Reconnect; "" = no folder access
    in property<string> web_dest_note: "";
    in-out property<bool> web_notify: false;
    in property<string> web_notify_note: "";
    in-out property<string> web_relay: "";
    in-out property<string> web_bridge: "";
    callback web_dest_choose();
    callback web_dest_forget();
    callback web_notify_toggled(bool);
    callback web_save_relay(string);
    callback web_save_bridge(string);

    in-out property<bool> fuse_mode: false;
    in property<bool> fuse_available: false;
    in property<string> fuse_install_hint: "Install macFUSE: macfuse.github.io";
    callback fuse_mode_toggled(bool);
    // Local mode toggle (direct LAN connection, skip relay)
    in-out property<bool> local_mode: false;
    in property<string> local_address: "";
    callback local_mode_toggled(bool);
    // LAN discovery
    in property<string> discovery_name: "";
    in-out property<[DiscoveredPeer]> discovered_peers: [];
    callback discovery_peer_selected(int); // called with peer index

    // Callbacks
    callback add_peer_code();
    callback copy_my_code();
    callback copy_invite_link(); // one page that carries the download and this code
    callback create_room_pressed();
    callback join_room_pressed();
    callback connect_pressed();
    callback disconnect_pressed();
    callback cancel_connect_pressed();
    callback open_folder_pressed();
    callback add_file_pressed();
    callback save_file(string);
    callback open_file(string);
    callback pause_file(string);
    callback unshare_file(string);
    callback save_all_pressed();
    callback exit_pressed();
    callback open_fuse_install();
    callback save_settings(string, string, string); // relay, save_path, mount_path
    callback tokens_add(string); // paste a prepaid relay token code
    callback tokens_buy();       // open the buy page in the browser
    in-out property<string> tokens_status_text: "";
    in-out property<string> tokens_add_result: "";
    // Main-screen chip: buy hint on unfunded relay sessions, quiet balance when funded.
    in-out property<bool> tokens_funded: false;
    in-out property<string> tokens_credit_short: "";

    // Contacts / Identity
    in-out property<[ContactInfo]> contacts: [];
    in-out property<bool> incognito_mode: false;
    in-out property<bool> peer_is_persistent: false;
    in-out property<bool> peer_already_saved: false;
    in-out property<bool> save_contact_visible: false;
    in-out property<string> save_contact_name: "";
    callback incognito_mode_toggled(bool);
    callback connect_to_contact(int);
    callback save_peer_as_contact(string);
    // No thanks on Save contact: Rust stops offering this friend.
    callback save_contact_declined();
    callback remove_contact(int);
    callback toggle_auto_connect(int);

    // Post-first-save FUSE offer
    in-out property<bool> fuse_offer_visible: false;
    in property<string> fuse_offer_body: "";
    in property<string> fuse_offer_action: "";
    callback fuse_offer_accepted();
    callback fuse_offer_declined();

    // Identity hardening (passphrase protect)
    in property<bool> passphrase_protect_enabled: false;
    callback passphrase_protect_toggled(bool);

    // Sharing toggles, persisted to config
    in-out property<bool> cfg_share_read_only: false;
    in-out property<bool> cfg_mount_read_only: false;
    in-out property<bool> cfg_preserve_metadata: false;
    callback share_read_only_toggled(bool);
    callback mount_read_only_toggled(bool);
    callback preserve_metadata_toggled(bool);

    in-out property<bool> help_visible: false;
    in-out property<bool> settings_visible: false;

    // Feedback overlay: sends a problem report to the KeibiDrop inbox
    in-out property<bool> feedback_visible: false;
    in-out property<bool> feedback_sending: false;
    in-out property<string> feedback_message: "";
    in-out property<string> feedback_contact: "";
    in-out property<int> feedback_rating: 0;   // 1 to 5 stars, 0 = none
    // Send the app's recent log too, sanitized (Rust: KD_SendFeedback).
    in-out property<bool> feedback_include_logs: false;
    callback send_feedback(string, string, int, bool);
    callback open_help_url();
    in property<string> cfg_relay: "";
    in property<string> cfg_save_path: "";
    in property<string> cfg_mount_path: "";
    in property<string> cfg_log_file: "";
    in property<string> cfg_config_path: "";
    callback open_config();      // open config.toml in the system text editor

    // Saved files browser (Screen 3)
    in-out property<[FileInfo]> saved_file_list: [];
    in-out property<string> saved_current_folder: "";
    callback view_saved_files();
    callback back_to_connect();
    callback delete_file(string);
    callback open_save_folder();
    callback navigate_saved_folder(string);
    callback back_saved_folder();

    // Header "..." menu
    in-out property<bool> menu_open: false;
    property<bool> can_save_peer: root.peer_is_persistent && !root.incognito_mode && !root.peer_already_saved;
    // Her order (Figma Screens 12 to 14): Disconnect first, Settings last.
    property<[MenuEntry]> menu_entries: root.web && root.current_screen == 1 && root.can_save_peer
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "saveall", label: "Save all", a11y: "Save all" },
           { id: "saved", label: "Saved files", a11y: "Saved files" },
           { id: "savepeer", label: "Save contact", a11y: "Save contact" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.web && root.current_screen == 1
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "saveall", label: "Save all", a11y: "Save all" },
           { id: "saved", label: "Saved files", a11y: "Saved files" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.web
        ? [{ id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 1 && root.can_save_peer
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "saveall", label: "Save all", a11y: "Save all" },
           { id: "savepeer", label: "Save contact", a11y: "Save contact" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 1
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "saveall", label: "Save all", a11y: "Save all" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 2 && root.can_save_peer
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "savepeer", label: "Save contact", a11y: "Save contact" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 2
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 3
        ? [{ id: "folder", label: "Open folder", a11y: "Open folder" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : [{ id: "saved", label: "Saved files", a11y: "Saved files" },
           { id: "settings", label: "Settings", a11y: "Open settings" }];

    // Overlays blur the window behind them. Rust takes the snapshot while
    // capturing is true, with the header and the overlay hidden, and blurs
    // it off the UI thread (lib.rs install_backdrop).
    out property<bool> overlay_open: root.help_visible || root.settings_visible || root.feedback_visible
        || root.save_contact_visible || root.fuse_offer_visible;
    in-out property<bool> capturing: false;
    callback capture_backdrop();
    changed overlay_open => {
        if (self.overlay_open) {
            root.capture_backdrop();
        }
    }
    changed current_screen => {
        if (self.overlay_open) {
            root.capture_backdrop();
        }
    }

    // Help card steps (Figma Screen 13 for the connect screen).
    // Plain words, the same ones the buttons and switches use.
    property<[string]> help_steps: root.web && root.current_screen == 1
        ? ["Drag files or folders onto the window or click the +. Keep this tab open: your friend reads your files from it.",
           "Open plays videos and music and shows PDFs and pictures without saving them. The arrow next to Open saves a copy.",
           "Save all is in the ... menu. In Chrome and Edge, a save folder chosen in Settings takes every save without asking."]
        : root.web
        ? ["Press Copy and send your code to your friend, or press Invite link and send the link.",
           "Paste the code your friend sent you, or open their invite link. You both press Connect.",
           "Nothing to install: KeibiDrop runs in this tab. Drag files onto the window to send them once you are connected."]
        : root.current_screen == 1
        ? ["Drag files onto the window or click the +. Your friend sees your files and can save them.",
           "Click Save to download one of their files, or Save all in the ... menu. Save contact keeps your friend in your contacts.",
           "Under the logo: LAN means same Wi-Fi, Direct P2P means straight to your friend, Via Relay means through our relay, still encrypted."]
        : root.current_screen == 2
        ? ["Teleport allows you to instantly open shared files. It works as a folder on both computers.",
           "Press Open Folder, then open any file with any app.",
           "Put your files in the Teleport Folder to send them to your friend."]
        : ["Same Wi-Fi? Turn on Local mode on both computers, then click Connect next to your friend's name.",
           "Anywhere else: press Copy and send your code to your friend. Paste the code they send you. You both press Connect.",
           "Drag files onto the window to send them. Teleport allows you to instantly open shared files, as a folder on both computers."];

    function show_overlay(help: bool, feedback: bool, settings: bool) {
        root.menu_open = false;
        root.help_visible = help;
        root.feedback_visible = feedback;
        root.settings_visible = settings;
    }
    function close_overlays() {
        root.show_overlay(false, false, false);
        if (root.save_contact_visible) {
            root.save_contact_visible = false;
            root.save_contact_name = "";
        }
        if (root.fuse_offer_visible) {
            root.fuse_offer_declined();
        }
    }
    function menu_pick(id: string) {
        root.menu_open = false;
        if (id == "saved") {
            root.view_saved_files();
        } else if (id == "settings") {
            root.show_overlay(false, false, true);
        } else if (id == "disconnect") {
            root.disconnect_pressed();
        } else if (id == "savepeer") {
            root.save_contact_visible = true;
        } else if (id == "saveall") {
            root.save_all_pressed();
        } else if (id == "folder") {
            root.open_save_folder();
        }
    }
    // The header X closes the menu, then an overlay, then the app.
    function close_or_quit() {
        if (root.menu_open) {
            root.menu_open = false;
        } else if (root.overlay_open) {
            root.close_overlays();
        } else {
            root.exit_pressed();
        }
    }

    // Opaque backdrop - ensures full coverage on Wayland where
    // Window.background alone may not fill the compositor surface.
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.background;
    }
    // Her background (Figma NEW 2.0) reaches past her frame on every side;
    // it stretches with the window.
    Background {
        x: root.width * (-64.5px / Theme.frame-width);
        y: root.height * (-42px / Theme.frame-height);
        width: root.width * (1245px / Theme.frame-width);
        height: root.height * (830px / Theme.frame-height);
    }

    // ============ SCREEN 0: Connect (Figma NEW 2.0: 271:778, local mode 273:1324) ============
    if current_screen == 0: Rectangle {
        x: root.column-x;
        width: Theme.frame-width;
        height: 100%;
        property <float> alpha: 0.0;
        // Her right column: the switches, then Connect, or the nearby
        // devices in local mode.
        property <length> right-x: 828px;
        property <length> switch-x: 828.66px;
        // While connecting nothing moves: the switches stay, dimmed and
        // locked; in local mode the countdown takes the line of "Nearby
        // devices" and Cancel the first device's row.
        property <bool> connecting: root.room_action != 0;
        property <float> settled: self.connecting ? 0.5 : 1;
        property <length> cancel-y: root.local_mode ? 420px : 480px;
        // Errors and news, 8px under whatever ends the column: Cancel while
        // connecting, the last nearby device (four show), the hint, or Connect.
        property <length> devices-end: root.discovered_peers.length == 0 ? 412px
            : 420px + min(4, root.discovered_peers.length) * 50px - 11px;
        property <length> notes-y: self.connecting ? self.cancel-y + Theme.button-height + 8px
            : root.local_mode ? self.devices-end + 8px
            : root.peer_code_added ? 448px : 428px;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        // An open overlay shows its own title over the blur.
        if !root.overlay_open: Label {
            x: 1px;
            y: 113.5px;
            width: parent.width;
            height: 30px;
            horizontal-alignment: center;
            style: Theme.title;
            text: "Connect Securely";
        }
        if !root.overlay_open: Label {
            x: 0.5px;
            y: 149px;
            width: parent.width;
            height: 30px;
            horizontal-alignment: center;
            style: Theme.subtitle;
            text: "Exchange fingerprints to establish a secure connection";
        }

        Badge { x: 175px; y: 201px; number: 1; }
        Badge { x: 175px; y: 352px; number: 2; }

        // Card 1: the friend's code. Its second line is the hint, or what
        // became of the code.
        Box {
            x: 240.03px;
            y: 200.89px;
            width: 528.12px;
            height: 134.8px;

            Label {
                x: 26.95px;
                y: 19.82px;
                height: 19px;
                style: Theme.card-heading;
                color: Theme.text-strong;
                text: root.local_mode ? "Friend's Address" : "Friend's Code";
            }
            Label {
                x: 26.95px;
                y: 43.61px;
                height: 13px;
                style: Theme.card-line;
                color: root.peer_code_error ? Theme.error : root.peer_code_added ? Theme.accent : Theme.muted;
                text: root.peer_code_error ? "Invalid code. Check that you copied the full code from your friend."
                    : root.peer_code_added ? "Friend's code added"
                    : root.local_mode ? "" : "Paste the code your friend sent you";
            }
            peer-field := Field {
                x: 26.95px;
                y: 69.78px;
                width: 477.37px;
                text <=> root.peer_code;
                accepted => { root.add_peer_code(); }
                FieldAction {
                    width: peer-field.button-width;
                    text: "Add";
                    clicked => { root.add_peer_code(); }
                }
            }
        }

        // Card 2: Your Code, or what stopped the engine, in its place
        if root.engine_error == "": Box {
            x: 240.03px;
            y: 351.55px;
            width: 528.12px;
            height: 149.08px;

            Label {
                x: 26.95px;
                y: 19.83px;
                height: 19px;
                style: Theme.card-heading;
                color: Theme.text-strong;
                text: root.local_mode ? "Your Address (local network)" : "Your Code";
            }
            if !root.local_mode: Label {
                x: 26.95px;
                y: 43.62px;
                height: 13px;
                style: Theme.card-line;
                color: Theme.muted;
                text: "Share this code with your friend";
            }
            code-field := Field {
                x: 26.95px;
                y: 69.79px;
                width: 477.37px;
                read-only: true;
                text: root.local_mode
                    ? (root.local_address != "" ? root.local_address : "No link-local address")
                    : root.my_code;
                FieldAction {
                    width: root.local_mode ? code-field.button-width : 98px;
                    dim: true;
                    nudge: root.local_mode ? 0 : -0.5px;
                    text: "Copy";
                    accessible-label: "Copy my code";
                    clicked => { root.copy_my_code(); }
                }
                // The invite link carries this code to the other person.
                if !root.local_mode: FieldAction {
                    x: 100px;
                    width: code-field.button-width - 100px;
                    dim: true;
                    text: "Invite link";
                    accessible-label: "Copy invite link";
                    clicked => { root.copy_invite_link(); }
                }
            }
            if !root.local_mode: Label {
                x: 26.95px;
                y: 118.16px;
                height: 12px;
                style: Theme.card-note;
                color: Theme.faint;
                text: "Send this code to your friend via Telegram, Signal, Email or Carrier Pigeon.";
            }
        }
        if root.engine_error != "": Box {
            x: 240.03px;
            y: 351.55px;
            width: 528.12px;
            height: 149.08px;
            line: Theme.error;

            Label {
                x: 26.95px;
                y: 19.83px;
                height: 19px;
                style: Theme.card-heading;
                color: Theme.error;
                text: "KeibiDrop could not start";
            }
            Label {
                x: 26.95px;
                y: 46px;
                width: parent.width - 54px;
                height: 48px;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
                style: Theme.card-line;
                color: Theme.text-soft;
                text: root.engine_error;
            }
            HorizontalLayout {
                x: 26.95px;
                y: 98px;
                height: Theme.button-height;
                spacing: 10px;
                alignment: start;
                PillButton { text: "Retry"; clicked => { root.engine_retry(); } }
                if !root.web: PillButton { plain: true; text: "Quit"; clicked => { root.engine_quit(); } }
            }
        }

        // Her line between the cards and the right column.
        Rectangle {
            x: 798px - Theme.line / 2;
            y: 210.41px;
            width: Theme.line;
            height: 280.71px;
            background: Theme.divider;
        }

        // Right column: identity and network switches, Connect, Teleport.
        // The browser has one switch: it sits where the desktop's last one
        // sits, the same gap above Connect.
        if !root.local_mode: ToggleRow {
            x: parent.switch-x;
            y: root.web ? 318px : 242px;
            width: 200px;
            opacity: parent.settled;
            enabled: !parent.connecting;
            text: "Incognito";
            checked <=> root.incognito_mode;
            toggled(v) => { root.incognito-mode-toggled(v); }
        }
        if !root.web: ToggleRow {
            x: parent.switch-x;
            y: 280px;
            width: 200px;
            opacity: parent.settled;
            enabled: !parent.connecting;
            text: "Local mode";
            checked <=> root.local_mode;
            toggled(v) => { root.local-mode-toggled(v); }
        }

        // Teleport switch (FUSE), her two lines (Figma NEW 2.0). Off, it
        // names her mode: Direct transfer.
        if !root.web: Rectangle {
            x: parent.switch-x;
            y: 318px;
            width: 200px;
            height: 30px;
            opacity: parent.settled;

            ToggleSwitch {
                x: 0;
                y: 0;
                accessible-label: "Teleport";
                checked <=> root.fuse_mode;
                enabled: root.fuse_available && root.room_action == 0;
                toggled(val) => { root.fuse-mode-toggled(val); }
            }
            Label {
                x: 51.81px;
                y: -1.34px;
                height: 15px;
                style: Theme.switch-label;
                color: Theme.switch-ink;
                text: !root.fuse_available ? "Teleport not available"
                    : root.fuse_mode ? "Teleport" : "Direct transfer";
            }
            Rectangle {
                x: 51.81px;
                y: 16.9px;
                width: 148px;
                height: fuse-hint.preferred-height;
                fuse-hint := Label {
                    width: parent.width;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    style: Theme.switch-detail;
                    color: fuse-hint-touch.has-hover || fuse-hint-touch.pressed ? Theme.text : Theme.caption-ink;
                    text: !root.fuse_available ? root.fuse_install_hint
                        : root.fuse_mode ? "Instantly open shared files" : "Select files to send";
                }
                fuse-hint-touch := TouchArea {
                    enabled: !root.fuse_available;
                    mouse-cursor: pointer;
                    clicked => { root.open-fuse-install(); }
                }
            }
        }

        // Connect button (role determined by fingerprint tiebreaker)
        if !root.local_mode: PillButton {
            x: parent.right-x;
            y: 381px;
            width: 201px;
            text: root.room_action != 0 ? "Connecting..." : "Connect";
            active: root.room_action != 0;
            // A typed code is enough: Connect registers it first (see on_connect_pressed).
            enabled: root.room_action == 0 && root.next_enabled && (root.peer_code_added || root.peer_code != "");
            clicked => { root.connect_pressed() }
        }
        if !root.local_mode && root.room_action == 0 && root.peer_code_added: Label {
            x: parent.right-x;
            y: 428px;
            height: 12px;
            style: Theme.card-note;
            color: Theme.faint;
            text: "You both press Connect.";
        }

        // While connecting: the countdown, what is missing, and Cancel.
        if root.room_action != 0: Label {
            x: root.local_mode ? 829px : parent.right-x;
            y: root.local_mode ? 399.5px : 428px;
            width: 201px;
            height: root.local_mode ? 12px : 14px;
            style: root.local_mode ? Theme.switch-detail : Theme.card-line;
            color: root.local_mode ? Theme.caption-ink : Theme.muted;
            text: root.connect_status != "" ? root.connect_status : "Connecting...";
        }
        // Waiting for the other side: name what is missing rather than spinning.
        if !root.local_mode && root.room_action != 0: Label {
            x: parent.right-x;
            y: 446px;
            width: 201px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.card-note;
            color: Theme.faint;
            text: "Waiting for the other side. They need your code too.";
        }
        if root.room_action != 0: PillButton {
            x: parent.right-x;
            y: parent.cancel-y;
            width: 201px;
            plain: true;
            text: "Cancel";
            clicked => { root.cancel_connect_pressed() }
        }

        // LAN discovery, in place of Connect while local mode is on (Figma
        // 273:1324): her highlighted rows, four in view, the rest scroll.
        if root.local_mode && root.discovery_name != "": Label {
            x: 829px;
            y: 381px;
            height: 15px;
            style: Theme.switch-label;
            color: Theme.accent;
            text: "You appear as: " + root.discovery_name;
        }
        if root.local_mode && root.room_action == 0: Label {
            x: 829px;
            y: 399.5px;
            height: 12px;
            style: Theme.switch-detail;
            color: Theme.caption-ink;
            text: root.discovered_peers.length > 0 ? "Nearby devices" : "Searching for devices...";
        }
        if root.local_mode && root.room_action == 0: Flickable {
            x: parent.right-x;
            y: 420px;
            width: 201px;
            height: 4 * 50px - 11px;
            content-height: max(self.height, root.discovered_peers.length * 50px - 11px);

            for peer[idx] in root.discovered_peers: DeviceRow {
                x: 0;
                y: idx * 50px;
                width: 201px;
                name: peer.name;
                clicked => { root.discovery-peer-selected(idx); }
            }
        }

        // Saved contacts (not while connecting or on the LAN path)
        if root.contacts.length > 0 && root.room_action == 0 && !root.local_mode: Label {
            x: 247.85px;
            y: 518.11px;
            height: 19px;
            style: Theme.list-heading;
            color: Theme.text-strong;
            text: "Contacts";
        }
        if root.contacts.length > 0 && root.room_action == 0 && !root.local_mode: ContactsPanel {
            x: 240px;
            y: 546px;
            width: 558px;
            height: 111px;
            contacts: root.contacts;
            web: root.web;
            connect(i) => { root.connect-to-contact(i); }
            auto(i) => { root.toggle_auto_connect(i); }
            remove(i) => { root.remove-contact(i); }
        }

        // Status and errors, under the right column.
        if root.error_message != "": Label {
            x: parent.right-x;
            y: parent.notes-y;
            width: 201px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.card-note;
            color: Theme.error;
            text: root.error_message;
        }
        if root.status_message != "" && root.error_message == "" && root.room_action == 0: Label {
            x: parent.right-x;
            y: parent.notes-y;
            width: 201px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.card-note;
            color: Theme.muted;
            text: root.status_message;
        }
    }

    // ============ SCREEN 1: Connected, no FUSE (Figma 214:988) ============
    // Her frame with the menu pill at its place on every screen, Save all in
    // its menu and the connection line under the logo.
    if current_screen == 1: Rectangle {
        x: root.column-x;
        width: Theme.frame-width;
        height: 100%;
        property <float> alpha: 0.0;
        // Where the files start: the folder row, then the grid under it.
        property <length> files-y: 274px;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        line := ConnectionLine {
            x: Theme.box-left;
            y: 106px;
            state: root.session_state;
            state-text: root.session_state_text;
            throughput: root.throughput_text;
            mode: root.connection_mode;
            funded: root.tokens_funded;
            credit: root.tokens_credit_short;
            offer-credit: !root.web;
            buy => { root.tokens_buy(); }
        }

        // Centred between the connection line and the files; her
        // ring's box is symmetric, so its centre is the drawn ring's centre.
        AddRing {
            x: 504px;
            y: (line.y + line.height + parent.files-y - self.height) / 2;
            spinning: root.drag_hovering || root.adding_files;
            clicked => { root.add_file_pressed(); }
        }

        if root.current_folder != "": FolderBar {
            x: Theme.box-left;
            y: parent.files-y;
            width: Theme.box-width;
            folder: root.current_folder;
            back => { root.back_folder(); }
        }

        FileGrid {
            x: Theme.box-left;
            y: parent.files-y + 45px;
            width: Theme.box-width;
            height: parent.height - self.y;
            files: root.file_list;
            web: root.web;
            open(file) => {
                if (file.file-type == "folder") {
                    root.navigate_folder(file.name);
                } else {
                    root.open_file(file.name);
                }
            }
            save(name) => { root.save_file(name); }
            pause(name) => { root.pause_file(name); }
            remove(name) => { root.unshare_file(name); }
        }
    }

    // ============ SCREEN 2: Connected, Teleport (Figma Screen 14) ============
    // Her card: the Teleport Folder, four points, its path with Open Folder;
    // her note under it. The card's X disconnects. Save contact is in
    // the menu; the connection line stays under the logo as on screen 1.
    if current_screen == 2: Rectangle {
        x: root.column-x;
        width: Theme.frame-width;
        height: 100%;
        property <float> alpha: 0.0;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        ConnectionLine {
            x: Theme.box-left;
            y: 106px;
            state: root.session_state;
            state-text: root.session_state_text;
            throughput: root.throughput_text;
            mode: root.connection_mode;
            funded: root.tokens_funded;
            credit: root.tokens_credit_short;
            buy => { root.tokens_buy(); }
        }

        Box {
            x: 282px;
            y: 216px;
            width: 587px;
            height: 319px;

            FolderIcon {
                x: 253.25px;
                y: 33.25px;
            }
            IconButton {
                x: 564px;
                y: 15px;
                width: 7px;
                height: 7px;
                icon: Icons.cross;
                accessible-label: "Disconnect";
                clicked => { root.disconnect_pressed(); }
            }
            // Centred where her text boxes centre: 292.5 and 291.
            Label {
                x: 93px;
                y: 115.5px;
                width: 400px;
                height: 30px;
                horizontal-alignment: center;
                silent: true;
                style: Theme.title-wide;
                text: "Open Teleport Folder";
            }
            // The folder and its title open the folder too.
            Rectangle {
                x: 93px;
                y: 30px;
                width: 400px;
                height: 116px;
                accessible-role: button;
                accessible-label: "Open Teleport Folder";
                accessible-action-default => { root.open_folder_pressed(); }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open_folder_pressed(); }
                }
            }
            Label {
                x: 41px;
                y: 148px;
                width: 500px;
                height: 30px;
                horizontal-alignment: center;
                style: Theme.subtitle;
                text: "Drop files into folder to share them instantly with your friend";
            }

            TeleportPoint { x: 74px; y: 204px; icon: Icons.file; icon-width: 16px; icon-height: 21px; text-x: 29px; text: "File system\non access"; }
            TeleportPoint { x: 195px; y: 204px; icon: Icons.play; icon-width: 21px; icon-height: 21px; text-x: 34px; text: "Open videos\nfiles directly"; }
            TeleportPoint { x: 302px; y: 204px; icon: Icons.code; icon-width: 22px; icon-height: 14px; icon-y: 3px; text-x: 29px; text: "View documents\nand code"; }
            TeleportPoint { x: 414px; y: 204px; icon: Icons.download; icon-width: 17px; icon-height: 21px; text-x: 28px; text: "No waiting\nfor full downloading"; }
            for line-x in [182px, 293px, 403px]: Rectangle {
                x: line-x - Theme.line / 2;
                y: 203px;
                width: Theme.line;
                height: 23px;
                background: Theme.divider;
            }

            path-field := Field {
                x: 69px;
                y: 253px;
                width: 445px;
                button-width: 166px;
                read-only: true;
                text: root.mount_path;
                FieldAction {
                    width: path-field.button-width;
                    text: "Open Folder";
                    clicked => { root.open_folder_pressed(); }
                }
            }
        }

        Box {
            x: 350px;
            y: 569px;
            width: 446px;
            height: 66px;
            fill: Theme.info-tint;

            Icon {
                x: 34px;
                y: 24px;
                width: 18px;
                height: 18px;
                icon: Icons.info;
                line: 1.5px;
            }
            Label {
                x: 83px;
                y: 20px;
                height: 13px;
                color: Theme.muted;
                text: "Files are available to your friend through a secure connection.";
            }
            TextAction {
                x: 83px;
                y: 33px;
                height: 13px;
                text: "How it works?";
                ink: Theme.accent;
                clicked => { root.show_overlay(true, false, false); }
            }
        }
    }

    // ============ SCREEN 3: Saved Files (Figma 214:988 without the (+)) ============
    // Her frame: like the no-FUSE screen without the (+), the row up where the old
    // screen had it (as far under the logo). Open folder is in the menu.
    if current_screen == 3: Rectangle {
        x: root.column-x;
        width: Theme.frame-width;
        height: 100%;
        property <float> alpha: 0.0;
        property <length> row-y: 139px;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        FolderBar {
            x: Theme.box-left;
            y: parent.row-y;
            width: Theme.box-width;
            folder: root.saved_current_folder != "" ? root.saved_current_folder : "Saved Files";
            note: root.saved_file_list.length == 1 ? "1 file" : root.saved_file_list.length + " files";
            back => {
                if (root.saved_current_folder != "") {
                    root.back_saved_folder();
                } else {
                    root.back_to_connect();
                }
            }
        }
        if root.saved_file_list.length == 0: VerticalLayout {
            x: Theme.box-left;
            y: parent.row-y + 45px;
            width: Theme.box-width;
            height: parent.height - self.y;
            alignment: center;
            spacing: 8px;
            Label {
                horizontal-alignment: center;
                style: Theme.heading;
                color: Theme.muted;
                text: "No saved files";
            }
            Label {
                horizontal-alignment: center;
                style: Theme.label;
                color: Theme.faint;
                text: "Files you download will appear here";
            }
        }

        if root.saved_file_list.length > 0: FileGrid {
            x: Theme.box-left;
            y: parent.row-y + 45px;
            width: Theme.box-width;
            height: parent.height - self.y;
            files: root.saved_file_list;
            browse-mode: true;
            web: root.web;
            open(file) => {
                if (file.file-type == "folder") {
                    root.navigate_saved_folder(file.name);
                } else {
                    root.open_file(file.name);
                }
            }
            remove(name) => { root.delete_file(name); }
        }
    }

    // ============ OVERLAYS: blurred window, sharp title, glass card ============

    // Help (Figma Screen 13)
    // The connect screen's card also explains contacts and Incognito between
    // two lines; a connected screen's card closes up under its steps, and its
    // title has no line about fingerprints.
    if root.help_visible: help := Overlay {
        property <length> contacts-part: root.current_screen == 0 ? 74px : 0;
        card-x: root.column-x + 313px;
        card-y: 262px;
        card-height: 346px + self.contacts-part;
        visible: !root.capturing;
        heading: "How to use KEIBI";
        heading-light: "DROP";
        subheading: root.current_screen == 0 ? "Exchange fingerprints to establish a secure connection" : "";
        dismiss => { root.help_visible = false; }

        for step[i] in root.help_steps: Rectangle {
            x: 58px;
            y: 46px + i * 57px;
            width: 401px;
            height: 39.65px;
            Badge { x: 0; y: 0; number: i + 1; }
            Label {
                x: 51.65px;
                y: -0.5px;
                width: 349.35px;
                height: parent.height;
                wrap: word-wrap;
                color: Theme.text-soft;
                text: step;
            }
        }
        Rectangle {
            x: 58px;
            y: 217.5px;
            width: 401px;
            height: Theme.line;
            background: Theme.divider;
        }
        if root.current_screen == 0: HorizontalLayout {
            x: 58px;
            y: 241.4px;
            width: 401px;
            height: 12.1px;
            alignment: center;
            Label { color: Theme.text; text: "Saved contacts appear below."; }
            Label { color: Theme.text-soft; text: " Click Connect next to a name."; }
        }
        if root.current_screen == 0: Label {
            x: 58px;
            y: 253.5px;
            width: 401px;
            height: 12.1px;
            horizontal-alignment: center;
            color: Theme.text-soft;
            text: "Incognito: you get a new code every time you connect. Nobody can save you as a contact.";
        }
        if root.current_screen == 0: Rectangle {
            x: 58px;
            y: 291.5px;
            width: 401px;
            height: Theme.line;
            background: Theme.divider;
        }
        Rectangle {
            x: 58px;
            y: 247.45px + help.contacts-part;
            width: 401px;
            height: 12.1px;
            HorizontalLayout {
                alignment: center;
                Label { style: Theme.small-strong; color: Theme.accent; text: "Guide with short videos:"; }
                Label { color: Theme.accent; text: " keibidrop.com/how-to-use"; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open_help_url(); }
            }
        }
        IconButton {
            x: 497px;
            y: 11px;
            width: 7px;
            height: 7px;
            icon: Icons.cross;
            accessible-label: "Close help";
            clicked => { root.help_visible = false; }
        }
        PillButton {
            x: 179px;
            y: 279px + help.contacts-part;
            text: "Question?";
            clicked => { root.show_overlay(false, true, false); }
        }
    }

    // Settings. Fits the window and scrolls when short.
    if root.settings_visible && !root.web: settings := Overlay {
        visible: !root.capturing;
        card-width: 500px;
        card-height: min(700px, root.height - 24px);
        card-x: (root.width - 500px) / 2;
        card-y: (root.height - self.card-height) / 2;
        dismiss => { root.settings_visible = false; }

        ScrollView {
            x: 0;
            y: 0;
            width: settings.card-width;
            height: settings.card-height;
            content-height: 700px;

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Settings"; }

        // Relay
        Label { x: 20px; y: 56px; height: 14px; style: Theme.small; color: Theme.muted; text: "Relay server"; }
        Label { x: 20px; y: 72px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_relay; }

        // Save path
        Label { x: 20px; y: 100px; height: 14px; style: Theme.small; color: Theme.muted; text: "Save path (received files)"; }
        Label { x: 20px; y: 116px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_save_path; }

        // Mount path
        Label { x: 20px; y: 144px; height: 14px; style: Theme.small; color: Theme.muted; text: "Teleport Folder"; }
        Label { x: 20px; y: 160px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_mount_path; }

        // Log file
        Label { x: 20px; y: 188px; height: 14px; style: Theme.small; color: Theme.muted; text: "Log file"; }
        Label { x: 20px; y: 204px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_log_file; }

        // Config file
        Label { x: 20px; y: 232px; height: 14px; style: Theme.small; color: Theme.muted; text: "Config file"; }
        Label { x: 20px; y: 248px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_config_path; }

        // Version
        Label { x: 20px; y: 284px; height: 14px; style: Theme.small; color: Theme.muted; text: "Version"; }
        Label { x: 20px; y: 300px; height: 16px; style: Theme.label; color: Theme.text-soft; text: root.version_text; }

        // Passphrase protect toggle
        Rectangle {
            x: 20px;
            y: 334px;
            width: parent.width - 40px;
            height: 24px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                checked: root.passphrase_protect_enabled;
                toggled(val) => {
                    root.passphrase-protect-toggled(val);
                }
            }
            Label { x: 48px; height: 24px; style: Theme.switch-label; color: Theme.switch-ink; text: "Encrypt identity with a passphrase"; }
        }

        // Share read only
        Rectangle {
            x: 20px;
            y: 372px;
            width: parent.width - 40px;
            height: 44px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                accessible-label: "Share is read only";
                checked <=> root.cfg_share_read_only;
                toggled(val) => { root.share_read_only_toggled(val); }
            }
            Label { x: 48px; y: 0; height: 24px; style: Theme.switch-label; color: Theme.switch-ink; text: "Share is read only"; }
            Label {
                x: 48px;
                y: 24px;
                width: parent.width - 64px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Friends can open your files. Their changes and new files are refused. Takes effect at the next connection.";
            }
        }

        // Mount read only
        Rectangle {
            x: 20px;
            y: 424px;
            width: parent.width - 40px;
            height: 44px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                accessible-label: "Teleport Folder is read only";
                checked <=> root.cfg_mount_read_only;
                toggled(val) => { root.mount_read_only_toggled(val); }
            }
            Label { x: 48px; y: 0; height: 24px; style: Theme.switch-label; color: Theme.switch-ink; text: "Teleport Folder is read only"; }
            Label {
                x: 48px;
                y: 24px;
                width: parent.width - 64px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Programs on this computer can open files in the Teleport Folder but cannot change them. Takes effect at the next connection.";
            }
        }

        // Preserve metadata
        Rectangle {
            x: 20px;
            y: 476px;
            width: parent.width - 40px;
            height: 44px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                accessible-label: "Keep original timestamps";
                checked <=> root.cfg_preserve_metadata;
                toggled(val) => { root.preserve_metadata_toggled(val); }
            }
            Label { x: 48px; y: 0; height: 24px; style: Theme.switch-label; color: Theme.switch-ink; text: "Keep original timestamps"; }
            Label {
                x: 48px;
                y: 24px;
                width: parent.width - 64px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Received files keep the sender's file times and permissions. Applies to files that finish saving after you turn this on.";
            }
        }

        // Relay credit (prepaid priority tokens)
        Label { x: 20px; y: 528px; height: 14px; style: Theme.small; color: Theme.muted; text: "Relay credit"; }
        Label { x: 20px; y: 544px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; overflow: elide; text: root.tokens_status_text; }
        tokens-input := Field {
            x: 20px;
            y: 566px;
            width: 438px;
            button-width: 142px;
            accepted => {
                root.tokens_add(tokens-input.text);
                tokens-input.text = "";
            }
            FieldAction {
                width: tokens-input.button-width;
                text: "Add";
                clicked => {
                    root.tokens_add(tokens-input.text);
                    tokens-input.text = "";
                }
            }
        }
        Label { x: 20px; y: 606px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; overflow: elide; text: root.tokens_add_result; }
        Rectangle {
            x: 20px;
            y: 632px;
            width: parent.width - 40px;
            height: 26px;
            SmallOutlineButton {
                x: 0;
                y: 0;
                width: 150px;
                text: "Buy relay credit";
                clicked => { root.tokens_buy(); }
            }
            Label { x: 160px; height: 26px; style: Theme.small; color: Theme.faint; text: "Prepaid, anonymous, no account. Paste the code above."; }
        }

        // Config file editing
        Rectangle {
            x: 20px;
            y: 664px;
            width: parent.width - 40px;
            height: 26px;
            SmallOutlineButton {
                x: 0;
                y: 0;
                width: 150px;
                text: "Edit config file";
                clicked => { root.open_config(); }
            }
            Label { x: 160px; height: 26px; style: Theme.small; color: Theme.faint; text: "All settings, with defaults. Changes apply at the next start."; }
        }
        }

        SmallOutlineButton {
            x: settings.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.settings_visible = false; }
        }
    }

    // Settings in the browser: where saves go, notifications, the servers.
    if root.settings_visible && root.web: web-settings := Overlay {
        visible: !root.capturing;
        card-width: 500px;
        card-height: 408px;
        card-x: (root.width - 500px) / 2;
        card-y: (root.height - self.card-height) / 2;
        dismiss => { root.settings_visible = false; }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Settings"; }

        Label { x: 20px; y: 56px; height: 14px; style: Theme.small; color: Theme.muted; text: "Save folder"; }
        Label { x: 20px; y: 72px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; overflow: elide; text: root.web_dest != "" ? root.web_dest : "Ask each time"; }
        HorizontalLayout {
            x: 20px;
            y: 96px;
            height: 24px;
            spacing: 10px;
            alignment: start;
            if root.web_dest_action != "": SmallOutlineButton {
                text: root.web_dest_action;
                clicked => { root.web_dest_choose(); }
            }
            if root.web_dest != "": SmallOutlineButton {
                text: "Forget";
                clicked => { root.web_dest_forget(); }
            }
        }
        Label { x: 20px; y: 128px; width: 460px; wrap: word-wrap; vertical-alignment: top; style: Theme.small; color: Theme.faint; text: root.web_dest_note; }

        ToggleRow {
            x: 20px;
            y: 170px;
            width: 460px;
            text: "Tell me when a transfer ends while this tab is in the background";
            checked <=> root.web_notify;
            toggled(v) => { root.web_notify_toggled(v); }
        }
        Label { x: 68px; y: 196px; width: 412px; height: 12px; style: Theme.small; color: Theme.faint; text: root.web_notify_note; }

        Label { x: 20px; y: 222px; height: 14px; style: Theme.small; color: Theme.muted; text: "Relay server (empty: the built-in one)"; }
        relay-field := Field {
            x: 20px;
            y: 240px;
            width: 460px;
            button-width: 90px;
            text <=> root.web_relay;
            accepted => { root.web_save_relay(self.text); }
            FieldAction {
                width: relay-field.button-width;
                text: "Save";
                clicked => { root.web_save_relay(relay-field.text); }
            }
        }
        Label { x: 20px; y: 288px; height: 14px; style: Theme.small; color: Theme.muted; text: "Bridge server (empty: the built-in one)"; }
        bridge-field := Field {
            x: 20px;
            y: 306px;
            width: 460px;
            button-width: 90px;
            text <=> root.web_bridge;
            accepted => { root.web_save_bridge(self.text); }
            FieldAction {
                width: bridge-field.button-width;
                text: "Save";
                clicked => { root.web_save_bridge(bridge-field.text); }
            }
        }

        Label { x: 20px; y: 356px; height: 14px; style: Theme.small; color: Theme.muted; text: "Version"; }
        Label { x: 20px; y: 372px; height: 16px; style: Theme.label; color: Theme.text-soft; text: root.version_text; }

        SmallOutlineButton {
            x: web-settings.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.settings_visible = false; }
        }
    }

    // Feedback: stars and a message to the KeibiDrop inbox, no mail app needed
    if root.feedback_visible: feedback := Overlay {
        // The browser has no log files: no Include logs, the rest moves up.
        property <length> logs-row: root.web ? 0 : 28px;
        visible: !root.capturing;
        card-width: 460px;
        card-height: 402px + self.logs-row;
        card-x: (root.width - self.card-width) / 2;
        card-y: (root.height - self.card-height) / 2;
        dismiss => { root.feedback_visible = false; }

        SmallOutlineButton {
            x: feedback.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.feedback_visible = false; }
        }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Report problem"; }

        // Five stars. Click one to rate, click it again to clear.
        for i in [1, 2, 3, 4, 5]: Rectangle {
            x: 20px + (i - 1) * 30px;
            y: 42px;
            width: 28px;
            height: 28px;
            Text {
                text: i <= root.feedback_rating ? "\u{2605}" : "\u{2606}";
                color: i <= root.feedback_rating ? Theme.accent : (star-touch.has-hover ? Theme.text : Theme.faint);
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            star-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.feedback_rating = root.feedback_rating == i ? 0 : i; }
            }
        }
        Label {
            x: 178px;
            y: 42px;
            height: 28px;
            style: Theme.caption;
            color: Theme.faint;
            text: root.feedback_rating == 0 ? "How is it going? Optional." : root.feedback_rating + " of 5";
        }

        Label { x: 20px; y: 78px; height: 16px; style: Theme.label; color: Theme.muted; text: "What happened? What did you expect instead?"; }

        TextEdit {
            x: 20px;
            y: 100px;
            width: feedback.card-width - 40px;
            height: 144px;
            font-size: 13px;
            wrap: word-wrap;
            text <=> root.feedback_message;
        }

        LineEdit {
            x: 20px;
            y: 254px;
            width: feedback.card-width - 40px;
            height: 30px;
            font-size: 13px;
            placeholder-text: "Email for a reply (optional)";
            text <=> root.feedback_contact;
        }

        // Off by default: logs go only when the person asks.
        if !root.web: ToggleRow {
            x: 20px;
            y: 294px;
            width: feedback.card-width - 40px;
            text: "Include logs";
            checked <=> root.feedback_include_logs;
        }

        Label {
            x: 20px;
            y: 294px + feedback.logs-row;
            width: feedback.card-width - 40px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.hint;
            color: Theme.faint;
            text: root.feedback_include_logs
                ? "Also sends the app's recent logs, up to 4 MB. File names, codes and addresses are taken out first."
                : "Sends your stars, your message, the reply address, the app version and the platform. Nothing else.";
        }

        PillButton {
            x: 20px;
            y: 338px + feedback.logs-row;
            width: 120px;
            text: root.feedback_sending ? "Sending..." : "Send";
            enabled: !root.feedback_sending && root.feedback_message != "";
            clicked => { root.send_feedback(root.feedback_message, root.feedback_contact, root.feedback_rating, root.feedback_include_logs); }
        }

        SmallOutlineButton {
            x: 152px;
            y: 343px + feedback.logs-row;
            text: "Cancel";
            clicked => { root.feedback_visible = false; }
        }
    }

    // Save contact: opens by itself the first time you connect to a
    // friend who is not a contact yet (Rust: finish_connect_ui), and from the
    // menu. No thanks closes it, and the app does not offer that friend again.
    if root.save_contact_visible: save-contact := Overlay {
        visible: !root.capturing;
        card-width: 360px;
        card-height: 170px;
        card-x: (root.width - 360px) / 2;
        card-y: (root.height - 170px) / 2;
        dismiss => { root.save_contact_visible = false; root.save_contact_name = ""; }
        init => { contact-name-input.focus(); }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Save contact"; }
        Label {
            x: 20px;
            y: 42px;
            height: 14px;
            style: Theme.small;
            color: Theme.muted;
            text: "Give your friend a name to connect again with one click.";
        }

        Box {
            kind: BoxKind.field;
            x: 20px;
            y: 66px;
            width: save-contact.card-width - 40px;
            height: 32px;

            contact-name-input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                color: Theme.text;
                font-size: Theme.label.size;
                vertical-alignment: center;
                single-line: true;
                accessible-label: "Contact name";
                text <=> root.save_contact_name;
                accepted => {
                    if root.save_contact_name != "" {
                        root.save-peer-as-contact(root.save_contact_name);
                        root.save_contact_visible = false;
                        root.save_contact_name = "";
                    }
                }
            }
        }

        PillButton {
            x: 20px;
            y: 116px;
            width: 155px;
            text: "Save";
            enabled: root.save_contact_name != "";
            clicked => {
                if root.save_contact_name != "" {
                    root.save-peer-as-contact(root.save_contact_name);
                    root.save_contact_visible = false;
                    root.save_contact_name = "";
                }
            }
        }
        PillButton {
            x: 185px;
            y: 116px;
            width: 155px;
            plain: true;
            text: "No thanks";
            clicked => {
                root.save_contact_visible = false;
                root.save_contact_name = "";
                root.save_contact_declined();
            }
        }
    }

    // Teleport offer (FUSE, after the first received file)
    if root.fuse_offer_visible: fuse-offer := Overlay {
        visible: !root.capturing;
        card-width: 380px;
        card-height: 190px;
        card-x: (root.width - 380px) / 2;
        card-y: (root.height - 190px) / 2;
        dismiss => { root.fuse_offer_declined(); }

        SmallOutlineButton {
            x: fuse-offer.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.fuse_offer_declined(); }
        }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Teleport"; }

        Label {
            x: 20px;
            y: 50px;
            width: fuse-offer.card-width - 40px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.label;
            color: Theme.text-soft;
            text: root.fuse_offer_body;
        }

        PillButton {
            x: 20px;
            y: 138px;
            width: 200px;
            text: root.fuse_offer_action;
            clicked => { root.fuse_offer_accepted(); }
        }

        SmallOutlineButton {
            x: 240px;
            y: 143px;
            width: 90px;
            text: "Not now";
            clicked => { root.fuse_offer_declined(); }
        }
    }

    // ============ GLOBAL: header, drawn above the overlays ============

    KeibiDropLogo {
        x: root.column-x + Theme.box-left;
        y: Theme.box-top;
        visible: !root.capturing;
    }

    // Control pill (Figma NEW 2.0): Report problem, her line, then her ?,
    // dots and X, white. Same place and size on every screen.
    Box {
        kind: BoxKind.panel;
        x: root.column-x + Theme.box-right - self.width;
        y: Theme.pill-y;
        width: Theme.pill-width;
        height: Theme.pill-height;
        visible: !root.capturing;

        TextAction {
            x: 17.02px;
            y: 5.22px;
            style: Theme.card-line;
            ink: Theme.text;
            hover-ink: Theme.link;
            text: "Report problem";
            clicked => { root.show_overlay(false, !root.feedback_visible, false); }
        }
        Rectangle {
            x: 116px - Theme.line / 2;
            y: 6px;
            width: Theme.line;
            height: 19px;
            background: Theme.divider;
        }
        IconButton {
            x: 132px;
            y: 12px;
            width: 5px;
            height: 8px;
            pad: 5px;
            icon: Icons.help;
            line: 1px;
            rest-ink: Theme.text;
            hover-ink: Theme.link;
            accessible-label: "Help";
            clicked => { root.show_overlay(!root.help_visible, false, false); }
        }
        IconButton {
            x: 151px;
            y: 15px;
            width: 14px;
            height: 2px;
            pad: 5px;
            icon: Icons.more;
            line: 1px;
            filled: true;
            rest-ink: Theme.text;
            hover-ink: Theme.link;
            accessible-label: "Menu";
            clicked => { root.menu_open = !root.menu_open; }
        }
        IconButton {
            x: 177px;
            y: 13px;
            width: 7px;
            height: 7px;
            pad: 5px;
            icon: Icons.cross;
            line: 1px;
            rest-ink: Theme.text;
            hover-ink: Theme.link;
            accessible-label: root.overlay_open ? "Close" : "Quit";
            clicked => { root.close_or_quit(); }
        }
    }

    // A click anywhere else closes the menu.
    if root.menu_open: TouchArea {
        clicked => { root.menu_open = false; }
    }
    // Only the rows this screen has: no empty slot at the top.
    if root.menu_open: Box {
        kind: BoxKind.panel;
        x: root.column-x + Theme.box-right - self.width;
        y: Theme.menu-y;
        width: Theme.pill-width;
        height: 20.62px + root.menu_entries.length * Theme.menu-row;
        visible: !root.capturing;
        for entry[i] in root.menu_entries: MenuItem {
            x: 0;
            y: 10.17px + i * Theme.menu-row;
            width: parent.width;
            first: i == 0;
            entry: entry;
            clicked => { root.menu_pick(entry.id); }
        }
    }

    // Toast notification (bottom-center, all screens)
    // At least 280 wide, wider when the message needs it.
    if root.toast_message != "": Box {
        kind: BoxKind.panel;
        x: (parent.width - self.width) / 2;
        y: parent.height - 56px;
        width: max(280px, toast-label.preferred-width + 32px);
        height: 32px;
        visible: !root.capturing;

        toast-label := Label {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            style: Theme.label;
            color: Theme.text;
            text: root.toast_message;
        }
    }

    // Version text, bottom right inside the box (all screens)
    Label {
        x: root.column-x + Theme.box-right - self.width;
        y: parent.height - self.height - 12px;
        style: Theme.chip;
        color: Theme.fainter;
        text: root.version_text;
    }

    // Update notice, bottom left inside the box (all screens), set when a newer release exists
    if root.update_available != "": upd-touch := TouchArea {
        x: root.column-x + Theme.box-left;
        y: parent.height - 34px;
        width: upd-note.width;
        height: 22px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Update notice";
        accessible-action-default => { root.open_update_page(); }
        clicked => { root.open_update_page(); }
        upd-note := Label {
            height: 22px;
            style: Theme.caption;
            color: upd-touch.has-hover || upd-touch.pressed ? Theme.text : Theme.accent;
            text: "Version " + root.update_available + " is out. Click to get it.";
        }
    }
}

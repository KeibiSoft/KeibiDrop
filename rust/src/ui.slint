import { ScrollView, TextEdit, LineEdit } from "std-widgets.slint";
import { Theme, Backdrop, Label, Glass, GlassKind, Outline, TextStyle } from "theme.slint";

// Rust fills it with the blurred window behind an overlay.
export { Backdrop } from "theme.slint";

// Discovered LAN peer
export struct DiscoveredPeer {
    name: string,
    addr: string,
}

// Saved contact from address book
export struct ContactInfo {
    name: string,
    fingerprint: string,
    online: bool,
    auto_connect: bool,
}

// File info model for dynamic file list
export struct FileInfo {
    name: string,
    size-bytes: int,
    downloading: bool,    // I'm downloading this file
    uploading: bool,      // peer is downloading this file from me
    progress: float,      // 0.0 to 1.0
    saved: bool,
    paused: bool,         // download was paused (can resume)
    file-type: string,    // "pdf", "image", "video", "audio", "code", "archive", "text", "other"
    is-local: bool,       // true = my file (shared by me), false = remote file (from peer)
}

// One row of the header's "..." menu.
export struct MenuEntry {
    id: string,
    label: string,
    a11y: string,
}

// Numbered step square.
component Badge inherits Outline {
    in property <int> number;
    width: Theme.control;
    height: Theme.control;

    Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        style: Theme.badge;
        color: Theme.faint;
        text: root.number;
    }
}

// Text that acts as a button. pad widens the hit area past the glyphs.
component TextAction inherits Rectangle {
    in property <string> text;
    in property <TextStyle> style: Theme.small;
    in property <color> ink: Theme.muted;
    in property <color> hover-ink: Theme.text;
    in property <length> pad: 0;
    callback clicked;

    width: label.preferred-width + 2 * root.pad;
    height: 20px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    label := Label {
        x: root.pad;
        height: parent.height;
        silent: true;
        style: root.style;
        text: root.text;
        color: touch.has-hover ? root.hover-ink : root.ink;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Input with the grey button attached on its right. Figma: the input is 303
// wide and the button covers its last 24px. The button parts are the children.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only;
    in property <length> button-width: 166px;
    callback accepted;

    height: Theme.control;

    Outline {
        x: 0;
        width: root.width - root.button-width + 24px;
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        background: Theme.field;
        clip: true;

        if root.read-only: Label {
            x: 16px;
            width: root.width - root.button-width - 20px;
            height: parent.height;
            style: Theme.code;
            color: Theme.text-soft;
            overflow: elide;
            text: root.text;
        }
        if !root.read-only: TextInput {
            x: 16px;
            width: root.width - root.button-width - 20px;
            height: parent.height;
            font-size: Theme.code.size;
            font-weight: Theme.code.weight;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            text <=> root.text;
            accepted => { root.accepted(); }
        }
    }
    Outline {
        x: root.width - root.button-width;
        width: root.button-width;
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        background: Theme.button;
        clip: true;
        @children
    }
}

// One clickable part of a field's grey button.
component FieldAction inherits Rectangle {
    in property <string> text;
    // Figma sets Copy and Invite link as one centred string; nudge matches it.
    in property <length> nudge: 0;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    background: touch.pressed ? #0000001f : touch.has-hover ? #ffffff14 : transparent;
    animate background { duration: 150ms; }

    Label {
        x: root.nudge;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        silent: true;
        style: Theme.button-label;
        color: Theme.on-button;
        text: root.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Toggle switch (reusable for FUSE and local mode)
// Switch (Figma Screen 12): a glass track; the knob is grey when off and
// white on the right when on.
component ToggleSwitch inherits Glass {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    kind: GlassKind.track;
    width: 36px;
    height: 20px;

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius-small;
        background: root.checked ? Theme.knob-on : Theme.knob-off;
        animate x { duration: 150ms; easing: ease-out; }
        animate background { duration: 150ms; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Switch with its label 48px to the right (Figma Screen 12).
component ToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 20px;

    ToggleSwitch {
        x: 0;
        y: 0;
        accessible-label: root.text;
        checked <=> root.checked;
        enabled: root.enabled;
        toggled(v) => { root.toggled(v); }
    }
    Label {
        x: 48px;
        height: parent.height;
        silent: true;
        style: Theme.label;
        color: root.checked ? Theme.text : Theme.muted;
        text: root.text;
    }
}

// Blue outline button: Connect, Question? and the overlay actions.
component PillButton inherits Rectangle {
    in-out property <string> text: "Button";
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    width: 161px;
    height: Theme.control;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.accent-line;
    background: root.active || pill-touch.pressed ? Theme.accent
              : pill-touch.has-hover ? #177df514
              : Theme.field;
    opacity: root.enabled || root.active ? 1 : 0.4;
    animate background { duration: 150ms; }

    Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        silent: true;
        style: Theme.primary;
        color: root.active || pill-touch.pressed ? Theme.text : Theme.accent;
        text: root.text;
    }

    pill-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small outline button (Save Peer, Save All, the overlays' X)
component SmallOutlineButton inherits Rectangle {
    in-out property <string> text: "?";
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    width: self.preferred-width;
    preferred-width: btn-label.preferred-width + 28px;
    height: 24px;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: small-touch.has-hover ? Theme.text : Theme.muted;
    animate border-color { duration: 150ms; }

    btn-label := Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        silent: true;
        style: Theme.caption;
        color: small-touch.has-hover ? Theme.text : Theme.muted;
        text: root.text;
    }

    small-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component KeibiDropLogo inherits Rectangle {
    width: 195px;
    height: 24px;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/logo.svg");
        image-fit: contain;
    }
}

// Outline button - white/grey by default, set accent: true for blue
component OutlineButton inherits Rectangle {
    in-out property <string> text: "Button";
    in property <bool> enabled: true;
    in property <bool> accent: false;
    callback clicked;

    width: 161px;
    height: Theme.control;
    border-width: Theme.hairline;
    border-radius: Theme.radius;
    border-color: !root.enabled ? Theme.faint : root.accent ? Theme.accent-line : Theme.outline;
    background: touch.pressed ? #ffffff14 : touch.has-hover ? #ffffff0a : transparent;
    animate background { duration: 150ms; }

    Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        style: Theme.button-label;
        color: !root.enabled ? Theme.faint : root.accent ? Theme.accent : Theme.text;
        text: root.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One saved contact: status dot, name, code, Auto, Connect (Figma Screen 12).
// Remove shows on hover only, so the row matches the design at rest.
component ContactRow inherits Rectangle {
    in property <ContactInfo> contact;
    callback connect;
    callback auto;
    callback remove;

    height: 20px;

    hover := TouchArea { }
    Rectangle {
        x: 18.06px;
        y: 8px;
        width: 5.64px;
        height: 5px;
        border-radius: 2.5px;
        background: root.contact.online ? Theme.online : Theme.offline;
    }
    Label {
        x: 57.8px;
        width: 105px;
        height: parent.height;
        overflow: elide;
        color: Theme.text-soft;
        text: root.contact.name;
    }
    Label {
        x: 169.3px;
        width: 165px;
        height: parent.height;
        overflow: elide;
        color: Theme.text-soft;
        text: root.contact.fingerprint;
    }
    TextAction {
        x: 340.9px;
        text: "Auto";
        accessible-label: "Auto connect " + root.contact.name;
        ink: root.contact.auto_connect ? Theme.link : Theme.muted;
        clicked => { root.auto(); }
    }
    TextAction {
        x: 413.1px;
        text: "Connect";
        accessible-label: "Connect to " + root.contact.name;
        ink: Theme.link;
        clicked => { root.connect(); }
    }
    remove-action := TextAction {
        x: 466px;
        pad: 4px;
        text: "X";
        accessible-label: "Remove " + root.contact.name;
        ink: hover.has-hover ? Theme.muted : transparent;
        hover-ink: Theme.error;
        clicked => { root.remove(); }
    }
}

// Saved contacts on glass: three rows show, the rest scroll (Figma Screen 12).
component ContactsPanel inherits Glass {
    in property <[ContactInfo]> contacts;
    callback connect(int);
    callback auto(int);
    callback remove(int);

    // Row tops in Figma: 5, 25, 46. Three rows show, the rest scroll.
    pure function row-y(i: int) -> length {
        return 5px + floor(i * 20.5 + 0.25) * 1px;
    }

    list := Flickable {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.row-y(3);
        content-height: max(self.height, root.row-y(root.contacts.length - 1) + 20px);

        for contact[i] in root.contacts: ContactRow {
            x: 0;
            y: root.row-y(i);
            width: 490px;
            contact: contact;
            connect => { root.connect(i); }
            auto => { root.auto(i); }
            remove => { root.remove(i); }
        }
    }
    if list.content-height > list.height: Rectangle {
        x: 495.55px;
        y: 9px + (root.height - 48px) * (-list.content-y / (list.content-height - list.height));
        width: 6.77px;
        height: 30px;
        border-radius: Theme.radius-small;
        background: Theme.scrollbar;
    }
}

// One row of the header's "..." menu.
component MenuItem inherits Rectangle {
    in property <MenuEntry> entry;
    // Figma places the chevrons on their own 20.5px grid.
    in property <length> chevron-y;
    callback clicked;

    height: 21px;
    accessible-role: button;
    accessible-label: root.entry.a11y;
    accessible-action-default => { root.clicked(); }

    Label {
        x: 18px;
        height: parent.height;
        silent: true;
        color: touch.has-hover ? Theme.text : Theme.muted;
        text: root.entry.label;
    }
    Image {
        x: 143.35px;
        y: root.chevron-y;
        width: 9.531px;
        height: 9.3px;
        source: @image-url("../assets/chevron.svg");
        colorize: touch.has-hover ? Theme.text : Theme.muted;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Full-window overlay (Figma Screen 13): the window blurred behind, a sharp
// title, and a frosted glass card that holds the children.
component Overlay inherits Rectangle {
    in property <string> heading;
    in property <string> heading-light;
    in property <string> subheading;
    in property <length> card-x: 313px;
    in property <length> card-y: 260px;
    in property <length> card-width: 517px;
    in property <length> card-height: 420px;
    callback dismiss;

    property <float> alpha: 0;
    opacity: root.alpha;
    animate opacity { duration: 220ms; easing: ease-out; }
    init => { root.alpha = 1; }

    Rectangle { background: Theme.window-dim; }
    Image {
        width: parent.width;
        height: parent.height;
        source: Backdrop.blur;
        image-fit: fill;
    }
    Rectangle { background: Theme.glass-tint; }
    TouchArea { clicked => { root.dismiss(); } }

    if root.heading != "": HorizontalLayout {
        x: 1.5px;
        y: 150px;
        width: parent.width;
        height: 30px;
        alignment: center;
        Label { style: Theme.title-wide; text: root.heading; }
        if root.heading-light != "": Label { style: Theme.title-light; text: root.heading-light; }
    }
    if root.subheading != "": Label {
        x: -0.5px;
        y: 185px;
        width: parent.width;
        height: 30px;
        horizontal-alignment: center;
        style: Theme.subtitle;
        text: root.subheading;
    }
    Glass {
        x: root.card-x;
        y: root.card-y;
        width: root.card-width;
        height: root.card-height;
        kind: GlassKind.card;
        frosted: true;
        // Clicks on the card stay on the card.
        TouchArea { }
        @children
    }
}

// Spinner arc with always-visible "+" center, clickable
component SpinnerArc inherits Rectangle {
    in property <length> size: 180px;
    in property <bool> spinning: false;
    callback clicked;

    width: size;
    height: size;

    // Continuous rotation using animation-tick
    property <float> angle: mod(animation-tick() / 8ms, 360);

    // Background ring (always visible)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        border-width: 6px;
        border-color: Theme.progress-track;
        background: transparent;
    }

    // Rotating arc (only when spinning)
    if root.spinning: Path {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Theme.progress;
        stroke-width: 3px;
        stroke-line-cap: round;
        fill: transparent;

        property <float> start: angle;
        property <float> arc-len: 90;
        property <float> r: 47;
        property <float> cx: 50;
        property <float> cy: 50;

        property <float> x1: cx + r * sin(start * 1deg);
        property <float> y1: cy - r * cos(start * 1deg);
        property <float> x2: cx + r * sin((start + arc-len) * 1deg);
        property <float> y2: cy - r * cos((start + arc-len) * 1deg);

        commands: "M " + x1 + " " + y1 + " A " + r + " " + r + " 0 0 1 " + x2 + " " + y2;
    }

    // Center "+" icon (always visible)
    Text {
        text: "+";
        font-size: root.size * 0.35;
        color: spinner-touch.has-hover ? Theme.progress : Theme.progress-track;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 150ms; }
    }

    spinner-touch := TouchArea {
        clicked => { root.clicked() }
    }
}

// Small spinner for file cards - shows progress 0->100%
component SmallSpinner inherits Rectangle {
    in property <bool> active: true;
    in property <color> accent: Theme.progress;
    in property <float> progress: 0.0;    // 0.0 to 1.0

    width: 20px;
    height: 20px;

    // Slow rotation so it looks alive even at fixed progress
    property <float> angle: active ? mod(animation-tick() / 10ms, 360) : 0;

    // Background circle (track)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: root.accent.darker(60%);
    }

    // Progress arc: arc-len = progress * 360° (min 30° so it's always visible when active)
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: root.accent;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;

        property <float> r: 7;
        property <float> cx: 10;
        property <float> cy: 10;
        property <float> start: angle;
        property <float> arc-len: clamp(root.progress * 340, 30, 340);
        // large-arc flag: 1 if arc > 180°
        property <float> large: arc-len > 180 ? 1 : 0;

        property <float> x1: cx + r * sin(start * 1deg);
        property <float> y1: cy - r * cos(start * 1deg);
        property <float> x2: cx + r * sin((start + arc-len) * 1deg);
        property <float> y2: cy - r * cos((start + arc-len) * 1deg);

        commands: "M " + x1 + " " + y1 + " A " + r + " " + r + " 0 " + large + " 1 " + x2 + " " + y2;
    }
}

// File type icon (emoji-based placeholder for different file types)
component FileTypeIcon inherits Rectangle {
    in property <string> file-type: "other";

    width: 48px;
    height: 48px;
    background: transparent;

    // Icon text based on file type
    Text {
        text: root.file-type == "folder" ? "DIR"
            : root.file-type == "pdf" ? "PDF"
            : root.file-type == "image" ? "IMG"
            : root.file-type == "video" ? "VID"
            : root.file-type == "audio" ? "SND"
            : root.file-type == "code" ? "</>"
            : root.file-type == "archive" ? "ZIP"
            : root.file-type == "text" ? "TXT"
            : "FILE";
        color: Theme.muted;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Progress bar
component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;  // 0.0 to 1.0

    width: 100%;
    height: 4px;
    background: Theme.progress-track;
    border-radius: 2px;

    Rectangle {
        width: parent.width * clamp(root.progress, 0, 1);
        height: 100%;
        background: Theme.progress;
        border-radius: 2px;

        animate width { duration: 300ms; easing: ease-out; }
        animate background { duration: 300ms; }
    }
}

// File card for non-FUSE mode (original design + progress)
component FileCard inherits Rectangle {
    in property <string> filename: "Project 123";
    in property <string> file-type: "other";
    in property <int> size-bytes: 0;
    in property <bool> downloading: false;
    in property <bool> uploading: false;
    in property <float> progress: 0.0;
    in property <bool> saved: false;
    in property <bool> is-local: false;
    in property <bool> paused: false;
    in property <bool> browse-mode: false;

    callback save-clicked;
    callback open-clicked;
    callback pause-clicked;
    callback delete-clicked;

    width: 250px;
    height: 180px;
    background: transparent;

    // Glass card background
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        background: rgba(255,255,255,0.03);
        border-width: 1px;
        border-color: rgba(255,255,255,0.08);
    }

    // Preview area (original grey style)
    Rectangle {
        width: parent.width;
        height: 140px;
        background: Theme.file-preview;
        border-radius: 4px;

        // File type icon centered
        FileTypeIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 10px;
            file-type: root.file-type;
        }

        // Green spinner: downloading from peer (top-left)
        if root.downloading: SmallSpinner {
            x: 8px;
            y: 8px;
            active: true;
            accent: Theme.progress;
        }

        // Blue spinner: uploading to peer (top-right)
        if root.uploading: SmallSpinner {
            x: parent.width - 28px;
            y: 8px;
            active: true;
            accent: Theme.progress;
        }

        // Progress bar at bottom of preview area
        if root.downloading: ProgressBar {
            x: 8px;
            y: parent.height - 18px;
            width: parent.width - 16px;
            progress: root.progress;
        }

        // Progress: percentage and size
        if root.downloading: Text {
            x: 8px;
            y: parent.height - 14px;
            text: Math.round(root.progress * 100) + "%";
            color: Theme.progress;
            font-size: 10px;
        }
        if root.downloading && root.size-bytes > 0: Text {
            x: parent.width - 8px;
            y: parent.height - 14px;
            horizontal-alignment: right;
            text: root.size-bytes > 1073741824
                ? Math.round(root.size-bytes / 10737418.24) / 100 + " GB"
                : root.size-bytes > 1048576
                ? Math.round(root.size-bytes / 10485.76) / 100 + " MB"
                : root.size-bytes > 1024
                ? Math.round(root.size-bytes / 10.24) / 100 + " KB"
                : root.size-bytes + " B";
            color: Theme.muted;
            font-size: 9px;
        }

        // Saved checkmark
        if root.saved && !root.downloading: Text {
            x: parent.width - 30px;
            y: 8px;
            text: "OK";
            color: Theme.online;
            font-size: 12px;
            font-weight: 700;
        }
    }

    // Bottom row (matches design: checkbox + name + button)
    HorizontalLayout {
        y: 148px;
        height: 28px;
        spacing: 8px;

        // Checkbox - shows progress spinner while downloading (hidden in browse mode)
        if root.downloading && !root.browse-mode: SmallSpinner {
            width: 20px;
            height: 20px;
            active: true;
            accent: Theme.progress;
            progress: root.progress;
        }
        if !root.downloading && !root.browse-mode: Rectangle {
            width: 20px;
            height: 20px;
            border-width: Theme.hairline;
            border-color: Theme.outline;
            border-radius: Theme.radius-small;
        }

        Text {
            text: filename;
            color: white;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        OutlineButton {
            width: 60px;
            height: 28px;
            text: root.paused ? "Resume" : "Pause";
            visible: root.downloading || root.paused;
            clicked => { root.pause-clicked(); }
        }

        OutlineButton {
            width: 80px;
            height: 28px;
            // "Open" is blue accent, "Save" is white/grey
            accent: root.is-local || root.saved;
            text: root.file-type == "folder" ? "Open"
                : root.downloading ? Math.round(root.progress * 100) + "%"
                : root.paused ? Math.round(root.progress * 100) + "%"
                : root.is-local ? "Open"
                : root.saved ? "Open"
                : "Save";
            enabled: root.file-type == "folder" || !root.downloading || root.paused;
            clicked => {
                if (root.file-type == "folder") { root.open-clicked(); }
                else if (root.paused) { root.save-clicked(); }
                else if (root.is-local || root.saved) { root.open-clicked(); }
                else { root.save-clicked(); }
            }
        }

        if root.is-local && !root.browse-mode: SmallOutlineButton {
            width: 24px;
            text: "X";
            clicked => { root.delete-clicked(); }
        }
        if root.browse-mode: SmallOutlineButton {
            width: 24px;
            text: "X";
            clicked => { root.delete-clicked(); }
        }
    }
}



export component MainWindow inherits Window {
    title: root.window_title;
    // KD_WINDOW_TITLE names the window when two instances run side by side.
    in property<string> window_title: "KEIBIDROP";
    default-font-family: "Inter";
    // Figma frames are 1144x729.
    preferred-width: 1144px;
    preferred-height: 729px;
    min-width: 1144px;
    min-height: 729px;
    background: root.capturing ? Theme.window-dim : Theme.window;

    // Data bindings from Rust
    in property<string> my_code: "";
    in-out property<string> peer_code: "";
    in property<bool> next_enabled: true;

    // Screen state: 0 = connect, 1 = connected (no-fuse), 2 = connected (fuse)
    in-out property<int> current_screen: 0;

    // Error message (shown on connect screen)
    in-out property<string> error_message: "";

    // Room action state: 0=none, 1=creating, 2=joining
    in-out property<int> room_action: 0;
    // Status message (shown below buttons on connect screen)
    in-out property<string> status_message: "";

    // Dynamic file list model (populated by Rust file watcher)
    in-out property<[FileInfo]> file_list: [];
    // Current folder path for navigation (empty = root)
    in-out property<string> current_folder: "";
    callback navigate_folder(string);
    callback back_folder();
    // Set by Rust when any file is actively downloading
    in-out property<bool> any_downloading: false;
    // Set by Rust when a file is being dragged over the window
    in-out property<bool> drag_hovering: false;
    // Mount path for FUSE mode (Screen 2)
    in property<string> mount_path: "";
    in property<string> connection_mode: ""; // "lan", "direct", "bridge", "direct-out" (our reads direct), "direct-in" (the peer's reads direct)
    // Toast message (brief feedback shown at bottom-center, auto-hides)
    in-out property<string> toast_message: "";
    // Peer code feedback: set by Rust after KD_AddPeerFingerprint
    in-out property<bool> peer_code_added: false;
    in-out property<bool> peer_code_error: false;
    in property<string> connect_status: "";
    // Live session state from the engine, polled every second: the state for
    // logic, the sentence for people, the rate. Same words as kd status.
    in-out property<string> session_state: "";
    in-out property<string> session_state_text: "";
    in-out property<string> throughput_text: "";
    // The engine could not start: shown in place of the code, with Retry and Quit.
    in-out property<string> engine_error: "";
    callback engine_retry();
    callback engine_quit();
    // Version string from Go (set by Rust at init)
    in property<string> version_text: "";
    // Newer released version, set by Rust when the update check finds one
    in property<string> update_available: "";
    callback open_update_page();
    // FUSE mode toggle (can be changed before connecting)
    in-out property<bool> fuse_mode: false;
    in property<bool> fuse_available: false;
    in property<string> fuse_install_hint: "Install macFUSE: macfuse.github.io";
    callback fuse_mode_toggled(bool);
    // Local mode toggle (direct LAN connection, skip relay)
    in-out property<bool> local_mode: false;
    in property<string> local_address: "";
    callback local_mode_toggled(bool);
    // LAN discovery
    in property<string> discovery_name: "";
    in-out property<[DiscoveredPeer]> discovered_peers: [];
    callback discovery_peer_selected(int); // called with peer index

    // Callbacks
    callback add_peer_code();
    callback copy_my_code();
    callback copy_invite_link(); // one page that carries the download and this code
    callback create_room_pressed();
    callback join_room_pressed();
    callback connect_pressed();
    callback disconnect_pressed();
    callback export_logs_pressed();
    callback cancel_connect_pressed();
    callback open_folder_pressed();
    callback add_file_pressed();
    callback save_file(string);
    callback open_file(string);
    callback pause_file(string);
    callback unshare_file(string);
    callback save_all_pressed();
    callback exit_pressed();
    callback open_fuse_install();
    callback save_settings(string, string, string); // relay, save_path, mount_path
    callback tokens_add(string); // paste a prepaid relay token code
    callback tokens_buy();       // open the buy page in the browser
    in-out property<string> tokens_status_text: "";
    in-out property<string> tokens_add_result: "";
    // Main-screen chip: buy hint on unfunded relay sessions, quiet balance when funded.
    in-out property<bool> tokens_funded: false;
    in-out property<string> tokens_credit_short: "";

    // Contacts / Identity
    in-out property<[ContactInfo]> contacts: [];
    in-out property<bool> incognito_mode: false;
    in-out property<bool> peer_is_persistent: false;
    in-out property<bool> peer_already_saved: false;
    in-out property<bool> save_contact_visible: false;
    in-out property<string> save_contact_name: "";
    callback incognito_mode_toggled(bool);
    callback connect_to_contact(int);
    callback save_peer_as_contact(string);
    callback remove_contact(int);
    callback toggle_auto_connect(int);

    // Post-first-save FUSE offer
    in-out property<bool> fuse_offer_visible: false;
    in property<string> fuse_offer_body: "";
    in property<string> fuse_offer_action: "";
    callback fuse_offer_accepted();
    callback fuse_offer_declined();

    // Identity hardening (passphrase protect)
    in property<bool> passphrase_protect_enabled: false;
    callback passphrase_protect_toggled(bool);

    // Sharing toggles, persisted to config
    in-out property<bool> cfg_share_read_only: false;
    in-out property<bool> cfg_mount_read_only: false;
    in-out property<bool> cfg_preserve_metadata: false;
    callback share_read_only_toggled(bool);
    callback mount_read_only_toggled(bool);
    callback preserve_metadata_toggled(bool);

    in-out property<bool> help_visible: false;
    in-out property<bool> settings_visible: false;

    // Feedback overlay: sends a problem report to the KeibiDrop inbox
    in-out property<bool> feedback_visible: false;
    in-out property<bool> feedback_sending: false;
    in-out property<string> feedback_message: "";
    in-out property<string> feedback_contact: "";
    in-out property<int> feedback_rating: 0;   // 1 to 5 stars, 0 = none
    callback send_feedback(string, string, int);
    callback open_help_url();
    in property<string> cfg_relay: "";
    in property<string> cfg_save_path: "";
    in property<string> cfg_mount_path: "";
    in property<string> cfg_log_file: "";
    in property<string> cfg_config_path: "";
    callback open_config();      // open config.toml in the system text editor

    // Saved files browser (Screen 3)
    in-out property<[FileInfo]> saved_file_list: [];
    in-out property<string> saved_current_folder: "";
    callback view_saved_files();
    callback back_to_connect();
    callback delete_file(string);
    callback open_save_folder();
    callback navigate_saved_folder(string);
    callback back_saved_folder();

    // Header "..." menu
    in-out property<bool> menu_open: false;
    property<bool> can_save_peer: root.peer_is_persistent && !root.incognito_mode && !root.peer_already_saved;
    property<[MenuEntry]> menu_entries: (root.current_screen == 1 || root.current_screen == 2) && root.can_save_peer
        ? [{ id: "savepeer", label: "Save peer", a11y: "Save Peer" },
           { id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "log", label: "Save log", a11y: "Save log" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 1 || root.current_screen == 2
        ? [{ id: "disconnect", label: "Disconnect", a11y: "Disconnect" },
           { id: "log", label: "Save log", a11y: "Save log" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : root.current_screen == 3
        ? [{ id: "log", label: "Save log", a11y: "Save log" },
           { id: "settings", label: "Settings", a11y: "Open settings" }]
        : [{ id: "saved", label: "Saved files", a11y: "Saved files" },
           { id: "log", label: "Save log", a11y: "Save log" },
           { id: "settings", label: "Settings", a11y: "Open settings" }];

    // Overlays blur the window behind them. Rust takes the snapshot while
    // capturing is true, with the header and the overlay hidden, and blurs
    // it off the UI thread (lib.rs install_backdrop).
    out property<bool> overlay_open: root.help_visible || root.settings_visible || root.feedback_visible
        || root.save_contact_visible || root.fuse_offer_visible;
    in-out property<bool> capturing: false;
    callback capture_backdrop();
    changed overlay_open => {
        if (self.overlay_open) {
            root.capture_backdrop();
        }
    }
    changed current_screen => {
        if (self.overlay_open) {
            root.capture_backdrop();
        }
    }

    // Help card steps (Figma Screen 13 for the connect screen).
    property<[string]> help_steps: root.current_screen == 1
        ? ["Drag files onto the window or press Add File. Your peer sees your files and can save them.",
           "Click Save to download a peer's file. Save Peer adds them to your contacts.",
           "Connection badge: LAN = same network, Direct P2P = over the internet, Via Relay = through encrypted bridge."]
        : root.current_screen == 2
        ? ["Your peer's files appear in the mounted folder. Open with any app: Finder, Terminal, git, etc.",
           "Files stream on access, no full download needed.",
           "Drop files into the folder to share. Save Peer adds them to your contacts."]
        : ["Same Wi-Fi: turn on the switch below Connect (it says Same network? \nTurn this on) on both computers, then click Connect next \nto the other computer.",
           "Anywhere else: press Copy my code, send the code to the other person, paste the code they send you. Both press Connect.",
           "Drag files onto the window to send them. Accept Files as a folder to open their files in any app."];

    function show_overlay(help: bool, feedback: bool, settings: bool) {
        root.menu_open = false;
        root.help_visible = help;
        root.feedback_visible = feedback;
        root.settings_visible = settings;
    }
    function close_overlays() {
        root.show_overlay(false, false, false);
        if (root.save_contact_visible) {
            root.save_contact_visible = false;
            root.save_contact_name = "";
        }
        if (root.fuse_offer_visible) {
            root.fuse_offer_declined();
        }
    }
    function menu_pick(id: string) {
        root.menu_open = false;
        if (id == "saved") {
            root.view_saved_files();
        } else if (id == "log") {
            root.export_logs_pressed();
        } else if (id == "settings") {
            root.show_overlay(false, false, true);
        } else if (id == "disconnect") {
            root.disconnect_pressed();
        } else if (id == "savepeer") {
            root.save_contact_visible = true;
        }
    }
    // The header X closes the menu, then an overlay, then the app.
    function close_or_quit() {
        if (root.menu_open) {
            root.menu_open = false;
        } else if (root.overlay_open) {
            root.close_overlays();
        } else {
            root.exit_pressed();
        }
    }

    // Opaque backdrop - ensures full coverage on Wayland where
    // Window.background alone may not fill the compositor surface.
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.background;
    }

    // ============ SCREEN 0: Connect (Figma Screen 12) ============
    if current_screen == 0: Rectangle {
        width: 100%;
        height: 100%;
        property <float> alpha: 0.0;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        // An open overlay shows its own title over the blur.
        if !root.overlay_open: Label {
            y: 150px;
            width: parent.width;
            height: 30px;
            horizontal-alignment: center;
            style: Theme.title;
            text: "Connect Securely";
        }
        if !root.overlay_open: Label {
            x: -0.5px;
            y: 185px;
            width: parent.width;
            height: 30px;
            horizontal-alignment: center;
            style: Theme.subtitle;
            text: "Exchange fingerprints to establish a secure connection";
        }

        Badge { x: 261px; y: 262px; number: 1; }
        Badge { x: 261px; y: 408px; number: 2; }

        // Card 1: the peer's code
        Outline {
            x: 314px;
            y: 262px;
            width: 517px;
            height: 131px;
            background: Theme.card;

            Label {
                x: 36px;
                y: 13.5px;
                height: 30px;
                style: Theme.heading-medium;
                text: root.local_mode ? "Peer Address" : "Peer Code";
            }
            peer-field := Field {
                x: 36px;
                y: 48px;
                width: 445px;
                text <=> root.peer_code;
                accepted => { root.add_peer_code(); }
                FieldAction {
                    width: peer-field.button-width;
                    height: Theme.control;
                    text: "Add";
                    clicked => { root.add_peer_code(); }
                }
            }
            Label {
                x: 36px;
                y: 96px;
                height: 12px;
                style: root.peer_code_error ? Theme.note : Theme.hint;
                color: root.peer_code_error ? Theme.error : root.peer_code_added ? Theme.accent : Theme.faint;
                text: root.peer_code_error ? "Invalid code. Check that you copied the full code from your peer."
                    : root.peer_code_added ? "Peer code added"
                    : root.local_mode ? "" : "Paste the code your peer sent you";
            }
        }

        // Card 2: Your Code, or what stopped the engine, in its place
        if root.engine_error == "": Outline {
            x: 314px;
            y: 408px;
            width: 517px;
            height: 161px;
            background: Theme.card;

            Label {
                x: 36px;
                y: 23px;
                height: 30px;
                style: Theme.heading;
                text: root.local_mode ? "Your Address (local network)" : "Your Code";
            }
            code-field := Field {
                x: 36px;
                y: 60px;
                width: 446px;
                button-width: 167px;
                read-only: true;
                text: root.local_mode
                    ? (root.local_address != "" ? root.local_address : "No link-local address")
                    : root.my_code;
                FieldAction {
                    x: 0;
                    width: root.local_mode ? code-field.button-width : 67px;
                    height: Theme.control;
                    text: "Copy";
                    nudge: root.local_mode ? 0 : 2.77px;
                    accessible-label: "Copy my code";
                    clicked => { root.copy_my_code(); }
                }
                // The invite link carries this code to the other person.
                if !root.local_mode: Rectangle {
                    x: 67px;
                    width: 1px;
                    height: Theme.control;
                    background: Theme.outline;
                }
                if !root.local_mode: FieldAction {
                    x: 68px;
                    width: code-field.button-width - 68px;
                    height: Theme.control;
                    text: "Invite link";
                    nudge: -2.14px;
                    accessible-label: "Copy invite link";
                    clicked => { root.copy_invite_link(); }
                }
            }
            if !root.local_mode: Label {
                x: 36px;
                y: 110px;
                width: 271px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Send this code to your peer via Telegram, Signal, Email or Carrier Pigeon.";
            }
        }
        if root.engine_error != "": Outline {
            x: 314px;
            y: 408px;
            width: 517px;
            height: 161px;
            background: Theme.card;
            border-color: Theme.error;
            Label {
                x: 36px;
                y: 13.5px;
                height: 30px;
                style: Theme.heading-medium;
                color: Theme.error;
                text: "KeibiDrop could not start";
            }
            Label {
                x: 36px;
                y: 44px;
                width: parent.width - 72px;
                height: 60px;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.text-soft;
                text: root.engine_error;
            }
            HorizontalLayout {
                x: 36px;
                y: 112px;
                height: 34px;
                spacing: 10px;
                alignment: start;
                PillButton { text: "Retry"; clicked => { root.engine_retry(); } }
                PillButton { text: "Quit"; clicked => { root.engine_quit(); } }
            }
        }

        // Right column: identity and network switches, Connect, virtual folder.
        if root.room_action == 0 && !root.local_mode: ToggleRow {
            x: 868px;
            y: 410px;
            width: 230px;
            text: "Incognito";
            checked <=> root.incognito_mode;
            toggled(v) => { root.incognito-mode-toggled(v); }
        }
        if root.room_action == 0: ToggleRow {
            x: 868px;
            y: 447px;
            width: 230px;
            text: "Local mode";
            checked <=> root.local_mode;
            toggled(v) => { root.local-mode-toggled(v); }
        }

        // Connect button (role determined by fingerprint tiebreaker)
        if !root.local_mode: PillButton {
            x: 868px;
            y: 535px;
            text: root.room_action != 0 ? "Connecting..." : "Connect";
            active: root.room_action != 0;
            // A typed code is enough: Connect registers it first (see on_connect_pressed).
            enabled: root.room_action == 0 && root.next_enabled && (root.peer_code_added || root.peer_code != "");
            clicked => { root.connect_pressed() }
        }
        if !root.local_mode && root.room_action == 0 && root.peer_code_added: Label {
            x: 868px;
            y: 577px;
            height: 12px;
            style: Theme.hint;
            color: Theme.faint;
            text: "Both peers press Connect.";
        }

        // While connecting: the countdown, what is missing, and Cancel.
        if root.room_action != 0: Label {
            x: 868px;
            y: 577px;
            width: 240px;
            height: 14px;
            style: Theme.label;
            color: Theme.muted;
            text: root.connect_status != "" ? root.connect_status : "Connecting...";
        }
        // Waiting for the other side: name what is missing rather than spinning.
        if !root.local_mode && root.room_action != 0: Label {
            x: 868px;
            y: 597px;
            width: 230px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.hint;
            color: Theme.faint;
            text: "Waiting for the other side. They need your code too.";
        }
        if root.room_action != 0: PillButton {
            x: 868px;
            y: 632px;
            text: "Cancel";
            clicked => { root.cancel_connect_pressed() }
        }

        // FUSE toggle: Medium first line, Light wrapped detail (Figma 8px).
        if root.room_action == 0: Rectangle {
            x: 868px;
            y: 482px;
            width: 230px;
            height: 30px;

            ToggleSwitch {
                x: 0;
                y: 0;
                accessible-label: "Virtual folder";
                checked <=> root.fuse_mode;
                enabled: root.fuse_available;
                toggled(val) => { root.fuse-mode-toggled(val); }
            }
            Label {
                x: 44px;
                y: -1.5px;
                height: 10px;
                style: Theme.tiny-strong;
                color: Theme.muted;
                text: root.fuse_available
                    ? (root.fuse_mode ? "Virtual folder" : "Direct transfer")
                    : "Virtual folder not available";
            }
            Rectangle {
                x: 44px;
                y: 8.5px;
                width: 117px;
                height: fuse-hint.preferred-height;
                fuse-hint := Label {
                    width: parent.width;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    style: Theme.tiny;
                    color: fuse-hint-touch.has-hover ? Theme.text : Theme.muted;
                    text: root.fuse_available
                        ? (root.fuse_mode ? "(files sync automatically)" : "(select files to send)")
                        : root.fuse_install_hint;
                }
                fuse-hint-touch := TouchArea {
                    enabled: !root.fuse_available;
                    mouse-cursor: pointer;
                    clicked => { root.open-fuse-install(); }
                }
            }
        }

        // LAN discovery, in place of Connect while local mode is on.
        if root.local_mode && root.discovery_name != "" && root.room_action == 0: Label {
            x: 868px;
            y: 535px;
            height: 14px;
            style: Theme.label;
            color: Theme.accent;
            text: "You appear as: " + root.discovery_name;
        }
        if root.local_mode && root.room_action == 0: Label {
            x: 868px;
            y: 557px;
            height: 14px;
            style: Theme.small;
            color: Theme.muted;
            text: root.discovered_peers.length > 0 ? "Nearby devices:" : "Searching for devices...";
        }
        for peer[idx] in root.discovered_peers: Outline {
            x: 868px;
            y: 577px + idx * 32px;
            width: 230px;
            height: 28px;
            visible: root.local_mode && root.room_action == 0;
            background: peer-touch.has-hover ? Theme.card : transparent;
            border-color: Theme.faint;
            accessible-role: button;
            accessible-label: "Connect to " + peer.name;
            accessible-action-default => { root.discovery-peer-selected(idx); }

            Label {
                x: 10px;
                width: parent.width - 80px;
                height: parent.height;
                overflow: elide;
                silent: true;
                style: Theme.label;
                color: Theme.text;
                text: peer.name;
            }
            Label {
                x: parent.width - 60px;
                height: parent.height;
                silent: true;
                style: Theme.label;
                color: Theme.link;
                text: "Connect";
            }
            peer-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.discovery-peer-selected(idx); }
            }
        }

        // Saved contacts (not while connecting or on the LAN path)
        if root.contacts.length > 0 && root.room_action == 0 && !root.local_mode: Label {
            x: 350px;
            y: 594.5px;
            height: 30px;
            style: Theme.section;
            text: "Contacts";
        }
        if root.contacts.length > 0 && root.room_action == 0 && !root.local_mode: ContactsPanel {
            x: 314px;
            y: 636px;
            width: 517px;
            height: 77px;
            contacts: root.contacts;
            connect(i) => { root.connect-to-contact(i); }
            auto(i) => { root.toggle_auto_connect(i); }
            remove(i) => { root.remove-contact(i); }
        }

        // Status and errors, under the right column.
        if root.error_message != "": Label {
            x: 868px;
            y: 340px;
            width: 240px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.note;
            color: Theme.error;
            text: root.error_message;
        }
        if root.status_message != "" && root.error_message == "" && root.room_action == 0: Label {
            x: 868px;
            y: 340px;
            width: 240px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.hint;
            color: Theme.muted;
            text: root.status_message;
        }
    }

    // ============ SCREEN 1: Connected (No FUSE) ============
    if current_screen == 1: Rectangle {
        width: 100%;
        height: 100%;
        property <float> alpha: 0.0;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        // Connected status - below logo
        HorizontalLayout {
            x: 115px;
            y: 55px;
            height: 22px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.session_state == "connected" || root.session_state == "" ? Theme.online
                          : root.session_state == "gave_up" || root.session_state == "mount_failed" ? Theme.error
                          : Theme.muted;
            }
            Text {
                text: root.session_state_text != "" ? root.session_state_text : "Connected";
                color: root.session_state == "connected" || root.session_state == "" ? Theme.online
                     : root.session_state == "gave_up" || root.session_state == "mount_failed" ? Theme.error
                     : Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
            if root.throughput_text != "": Text {
                text: root.throughput_text;
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.connection_mode != "": Rectangle {
                width: mode-text.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.connection_mode == "lan" ? Theme.online.transparentize(0.88)
                          : root.connection_mode == "direct" || root.connection_mode == "direct-out" ? Theme.accent.transparentize(0.88)
                          : Theme.muted.transparentize(0.88);
                mode-text := Text {
                    text: root.connection_mode == "lan" ? "LAN"
                        : root.connection_mode == "direct" ? "Direct P2P"
                        : root.connection_mode == "direct-out" ? "Direct reads"
                        : root.connection_mode == "direct-in" ? "Direct for peer"
                        : root.connection_mode == "bridge" ? "Via Relay"
                        : root.connection_mode;
                    color: root.connection_mode == "lan" ? Theme.online
                         : root.connection_mode == "direct" || root.connection_mode == "direct-out" ? Theme.accent
                         : Theme.muted;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // Relay credit: offer the buy page while unfunded, show balance when funded.
            if root.connection_mode == "bridge" && !root.tokens_funded: Rectangle {
                width: buy-chip-text.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.accent-line.transparentize(0.5);
                background: Theme.accent.transparentize(0.88);
                buy-chip-text := Text {
                    text: "Get relay credit";
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.tokens_buy(); }
                }
            }
            if root.connection_mode == "bridge" && root.tokens_funded && root.tokens_credit_short != "": Text {
                text: root.tokens_credit_short;
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Save All button - aligned with global top-right buttons
        SmallOutlineButton {
            x: 700px;
            y: 93px;
            width: 70px;
            text: "Save All";
            clicked => { root.save_all_pressed() }
        }

        // "+" circle always visible, spins only during drag-hover or active transfers
        SpinnerArc {
            x: (parent.width - self.width) / 2;
            y: 90px;
            size: 180px;
            spinning: root.drag_hovering || root.any_downloading;
            clicked => { root.add_file_pressed() }
        }

        // Back button (visible when inside a folder)
        if root.current_folder != "" : Rectangle {
            y: 310px;
            x: 40px;
            width: 200px;
            height: 30px;

            Text {
                text: "< Back";
                color: Theme.link;
                font-size: 14px;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.back_folder() }
            }
        }

        // Current folder label
        if root.current_folder != "" : Text {
            y: 312px;
            x: 250px;
            text: root.current_folder;
            color: Theme.muted;
            font-size: 13px;
        }

        // Scrollable file grid
        ScrollView {
            y: root.current_folder != "" ? 345px : 310px;
            width: parent.width;
            height: parent.height - (root.current_folder != "" ? 345px : 310px);
            content-height: Math.ceil(root.file_list.length / 4) * 200px;

            for file[idx] in root.file_list: FileCard {
                x: 40px + mod(idx, 4) * 265px;
                y: floor(idx / 4) * 200px;
                filename: file.name;
                file-type: file.file-type;
                size-bytes: file.size-bytes;
                downloading: file.downloading;
                uploading: file.uploading;
                progress: file.progress;
                saved: file.saved;
                is-local: file.is-local;
                paused: file.paused;
                save-clicked => {
                    if file.file-type == "folder" {
                        root.navigate_folder(file.name)
                    } else {
                        root.save_file(file.name)
                    }
                }
                open-clicked => {
                    if file.file-type == "folder" {
                        root.navigate_folder(file.name)
                    } else {
                        root.open_file(file.name)
                    }
                }
                pause-clicked => { root.pause_file(file.name) }
                delete-clicked => { root.unshare_file(file.name) }
            }
        }
    }

    // ============ SCREEN 2: Connected (FUSE present) ============
    if current_screen == 2: Rectangle {
        width: 100%;
        height: 100%;
        property <float> alpha: 0.0;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        // Connected status - below logo
        HorizontalLayout {
            x: 115px;
            y: 55px;
            height: 22px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.session_state == "connected" || root.session_state == "" ? Theme.online
                          : root.session_state == "gave_up" || root.session_state == "mount_failed" ? Theme.error
                          : Theme.muted;
            }
            Text {
                text: root.session_state_text != "" ? root.session_state_text : "Connected · FUSE mounted";
                color: root.session_state == "connected" || root.session_state == "" ? Theme.online
                     : root.session_state == "gave_up" || root.session_state == "mount_failed" ? Theme.error
                     : Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
            if root.throughput_text != "": Text {
                text: root.throughput_text;
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.connection_mode != "": Rectangle {
                width: fuse-mode-text.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.connection_mode == "lan" ? Theme.online.transparentize(0.88)
                          : root.connection_mode == "direct" ? Theme.accent.transparentize(0.88)
                          : Theme.muted.transparentize(0.88);
                fuse-mode-text := Text {
                    text: root.connection_mode == "lan" ? "LAN"
                        : root.connection_mode == "direct" ? "Direct P2P"
                        : root.connection_mode == "bridge" ? "Via Relay"
                        : root.connection_mode;
                    color: root.connection_mode == "lan" ? Theme.online
                         : root.connection_mode == "direct" ? Theme.accent
                         : Theme.muted;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // Relay credit: offer the buy page while unfunded, show balance when funded.
            if root.connection_mode == "bridge" && !root.tokens_funded: Rectangle {
                width: fuse-buy-chip-text.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.accent-line.transparentize(0.5);
                background: Theme.accent.transparentize(0.88);
                fuse-buy-chip-text := Text {
                    text: "Get relay credit";
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.tokens_buy(); }
                }
            }
            if root.connection_mode == "bridge" && root.tokens_funded && root.tokens_credit_short != "": Text {
                text: root.tokens_credit_short;
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // ── Main content ─────────────────────────────────────────
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding-left: 120px;
            padding-right: 120px;

            Text {
                text: "📁";
                font-size: 56px;
                color: white;
                horizontal-alignment: center;
            }

            Text {
                text: "Shared folder is live";
                color: white;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "Drop files into the folder to share them instantly with your peer.";
                color: Theme.muted;
                font-size: 15px;
                horizontal-alignment: center;
            }

            Text {
                text: "Files stream on access. Open videos, documents, or code without waiting for the full download.";
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: center;
            }

            if root.mount_path != "": Rectangle {
                height: 38px;
                border-radius: 19px;
                background: rgba(255,255,255,0.05);
                border-width: 1px;
                border-color: rgba(255,255,255,0.10);
                horizontal-stretch: 0;

                HorizontalLayout {
                    alignment: center;
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: root.mount_path;
                        color: Theme.faint;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                OutlineButton {
                    text: "Open Folder";
                    clicked => { root.open_folder_pressed() }
                }
                if root.peer_is_persistent && !root.incognito_mode && !root.peer_already_saved: OutlineButton {
                    text: "Save Peer";
                    clicked => { root.save_contact_visible = true; }
                }
            }
        }
    }

    // ============ SCREEN 3: Saved Files Browser ============
    if current_screen == 3: Rectangle {
        width: 100%;
        height: 100%;
        property <float> alpha: 0.0;
        opacity: alpha;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { alpha = 1.0; }

        // Header row: back + title + count left, utilities right
        OutlineButton {
            x: 40px;
            y: 88px;
            width: 90px;
            accent: true;
            text: "\u{2190} Back";
            clicked => { root.back_to_connect() }
        }

        Text {
            x: 140px;
            y: 91px;
            text: "Saved Files";
            color: white;
            font-size: 23px;
            font-weight: 700;
        }

        Text {
            x: 305px;
            y: 99px;
            text: root.saved_file_list.length == 1
                ? "1 file"
                : root.saved_file_list.length + " files";
            color: Theme.muted;
            font-size: 13px;
        }

        SmallOutlineButton {
            x: 780px;
            y: 93px;
            width: 80px;
            text: "Open Folder";
            clicked => { root.open_save_folder() }
        }

        // Folder navigation (inside saved files)
        if root.saved_current_folder != "": Rectangle {
            y: 130px;
            x: 40px;
            width: 200px;
            height: 30px;

            Text {
                text: "< Back";
                color: Theme.link;
                font-size: 14px;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.back_saved_folder() }
            }
        }

        if root.saved_current_folder != "": Text {
            y: 132px;
            x: 250px;
            width: parent.width - 260px;
            text: root.saved_current_folder;
            color: Theme.muted;
            font-size: 13px;
            overflow: elide;
        }

        // Empty state
        if root.saved_file_list.length == 0: VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: "No saved files";
                color: Theme.muted;
                font-size: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: "Files you download will appear here";
                color: Theme.faint;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        // File grid (same column layout as Screen 1)
        if root.saved_file_list.length > 0: ScrollView {
            y: root.saved_current_folder != "" ? 165px : 130px;
            width: parent.width;
            height: parent.height - (root.saved_current_folder != "" ? 165px : 130px);
            content-height: Math.ceil(root.saved_file_list.length / 4) * 200px;

            for file[idx] in root.saved_file_list: FileCard {
                x: 40px + mod(idx, 4) * 265px;
                y: floor(idx / 4) * 200px;
                filename: file.name;
                file-type: file.file-type;
                size-bytes: file.size-bytes;
                downloading: false;
                uploading: false;
                progress: 1.0;
                saved: true;
                is-local: true;
                paused: false;
                browse-mode: true;
                open-clicked => {
                    if file.file-type == "folder" {
                        root.navigate_saved_folder(file.name)
                    } else {
                        root.open_file(file.name)
                    }
                }
                save-clicked => {
                    if file.file-type == "folder" {
                        root.navigate_saved_folder(file.name)
                    }
                }
                delete-clicked => { root.delete_file(file.name) }
            }
        }
    }

    // ============ OVERLAYS: blurred window, sharp title, glass card ============

    // Help (Figma Screen 13)
    if root.help_visible: Overlay {
        visible: !root.capturing;
        heading: "How to use KEIBI";
        heading-light: "DROP";
        subheading: "Exchange fingerprints to establish a secure connection";
        dismiss => { root.help_visible = false; }

        for step[i] in root.help_steps: Rectangle {
            x: 58px;
            y: 49px + i * 57px;
            width: 401px;
            height: Theme.control;
            Badge { x: 0; y: 0; number: i + 1; }
            Label {
                x: 46px;
                y: -0.5px;
                width: 355px;
                height: parent.height;
                wrap: word-wrap;
                color: Theme.text-soft;
                text: step;
            }
        }
        if root.current_screen == 0: Rectangle {
            x: 58px;
            y: 217.5px;
            width: 401px;
            height: Theme.hairline;
            background: Theme.outline;
        }
        if root.current_screen == 0: HorizontalLayout {
            x: 58px;
            y: 241.4px;
            width: 401px;
            height: 12.1px;
            alignment: center;
            Label { color: Theme.text; text: "Saved contacts appear below."; }
            Label { color: Theme.text-soft; text: " Click Connect next to a name."; }
        }
        if root.current_screen == 0: Label {
            x: 58px;
            y: 253.5px;
            width: 401px;
            height: 12.1px;
            horizontal-alignment: center;
            color: Theme.text-soft;
            text: "Incognito: new keys each session. Nobody can save you as a contact.";
        }
        if root.current_screen == 0: Rectangle {
            x: 58px;
            y: 291.5px;
            width: 401px;
            height: Theme.hairline;
            background: Theme.outline;
        }
        Rectangle {
            x: 58px;
            y: 321.45px;
            width: 401px;
            height: 12.1px;
            HorizontalLayout {
                alignment: center;
                Label { style: Theme.small-strong; color: Theme.accent; text: "Guide with short videos:"; }
                Label { color: Theme.accent; text: " keibidrop.com/how-to-use"; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open_help_url(); }
            }
        }
        Rectangle {
            x: 496px;
            y: 5px;
            width: 13.004px;
            height: 13.004px;
            accessible-role: button;
            accessible-label: "Close help";
            accessible-action-default => { root.help_visible = false; }
            Image {
                x: 2.17px;
                y: 4.17px;
                width: 8.668px;
                height: 8.667px;
                source: @image-url("../assets/xmark.svg");
                colorize: help-close.has-hover ? Theme.text : Theme.muted;
            }
            help-close := TouchArea {
                x: -6px;
                y: -4px;
                width: 25px;
                height: 25px;
                mouse-cursor: pointer;
                clicked => { root.help_visible = false; }
            }
        }
        PillButton {
            x: 179px;
            y: 355px;
            text: "Question?";
            clicked => { root.show_overlay(false, true, false); }
        }
    }

    // Settings. Fits the window and scrolls when short.
    if root.settings_visible: settings := Overlay {
        visible: !root.capturing;
        card-width: 500px;
        card-height: min(700px, root.height - 24px);
        card-x: (root.width - 500px) / 2;
        card-y: (root.height - self.card-height) / 2;
        dismiss => { root.settings_visible = false; }

        ScrollView {
            x: 0;
            y: 0;
            width: settings.card-width;
            height: settings.card-height;
            content-height: 700px;

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Settings"; }

        // Relay
        Label { x: 20px; y: 56px; height: 14px; style: Theme.small; color: Theme.muted; text: "Relay server"; }
        Label { x: 20px; y: 72px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_relay; }

        // Save path
        Label { x: 20px; y: 100px; height: 14px; style: Theme.small; color: Theme.muted; text: "Save path (received files)"; }
        Label { x: 20px; y: 116px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_save_path; }

        // Mount path
        Label { x: 20px; y: 144px; height: 14px; style: Theme.small; color: Theme.muted; text: "Mount path (FUSE virtual folder)"; }
        Label { x: 20px; y: 160px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_mount_path; }

        // Log file
        Label { x: 20px; y: 188px; height: 14px; style: Theme.small; color: Theme.muted; text: "Log file"; }
        Label { x: 20px; y: 204px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_log_file; }

        // Config file
        Label { x: 20px; y: 232px; height: 14px; style: Theme.small; color: Theme.muted; text: "Config file"; }
        Label { x: 20px; y: 248px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; font-family: "monospace"; overflow: elide; text: root.cfg_config_path; }

        // Version
        Label { x: 20px; y: 284px; height: 14px; style: Theme.small; color: Theme.muted; text: "Version"; }
        Label { x: 20px; y: 300px; height: 16px; style: Theme.label; color: Theme.text-soft; text: root.version_text; }

        // Passphrase protect toggle
        Rectangle {
            x: 20px;
            y: 334px;
            width: parent.width - 40px;
            height: 24px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                checked: root.passphrase_protect_enabled;
                toggled(val) => {
                    root.passphrase-protect-toggled(val);
                }
            }
            Label { x: 48px; height: 24px; style: Theme.label; color: Theme.muted; text: "Encrypt identity with a passphrase"; }
        }

        // Share read only
        Rectangle {
            x: 20px;
            y: 372px;
            width: parent.width - 40px;
            height: 44px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                accessible-label: "Share is read only";
                checked <=> root.cfg_share_read_only;
                toggled(val) => { root.share_read_only_toggled(val); }
            }
            Label { x: 48px; y: 0; height: 24px; style: Theme.label; color: Theme.muted; text: "Share is read only"; }
            Label {
                x: 48px;
                y: 24px;
                width: parent.width - 64px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Peers can read your files. Changes and new files from peers are refused. Takes effect at the next connection.";
            }
        }

        // Mount read only
        Rectangle {
            x: 20px;
            y: 424px;
            width: parent.width - 40px;
            height: 44px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                accessible-label: "Virtual folder is read only";
                checked <=> root.cfg_mount_read_only;
                toggled(val) => { root.mount_read_only_toggled(val); }
            }
            Label { x: 48px; y: 0; height: 24px; style: Theme.label; color: Theme.muted; text: "Virtual folder is read only"; }
            Label {
                x: 48px;
                y: 24px;
                width: parent.width - 64px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Programs on this computer cannot write in the virtual folder. Takes effect at the next connection.";
            }
        }

        // Preserve metadata
        Rectangle {
            x: 20px;
            y: 476px;
            width: parent.width - 40px;
            height: 44px;

            ToggleSwitch {
                x: 0;
                y: 2px;
                accessible-label: "Keep original timestamps";
                checked <=> root.cfg_preserve_metadata;
                toggled(val) => { root.preserve_metadata_toggled(val); }
            }
            Label { x: 48px; y: 0; height: 24px; style: Theme.label; color: Theme.muted; text: "Keep original timestamps"; }
            Label {
                x: 48px;
                y: 24px;
                width: parent.width - 64px;
                wrap: word-wrap;
                vertical-alignment: top;
                style: Theme.hint;
                color: Theme.faint;
                text: "Received files keep the sender's file times and permissions. Applies to files that finish saving after you turn this on.";
            }
        }

        // Relay credit (prepaid priority tokens)
        Label { x: 20px; y: 528px; height: 14px; style: Theme.small; color: Theme.muted; text: "Relay credit"; }
        Label { x: 20px; y: 544px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; overflow: elide; text: root.tokens_status_text; }
        tokens-input := Field {
            x: 20px;
            y: 566px;
            width: 438px;
            button-width: 142px;
            accepted => {
                root.tokens_add(tokens-input.text);
                tokens-input.text = "";
            }
            FieldAction {
                width: tokens-input.button-width;
                height: Theme.control;
                text: "Add";
                clicked => {
                    root.tokens_add(tokens-input.text);
                    tokens-input.text = "";
                }
            }
        }
        Label { x: 20px; y: 606px; height: 16px; width: 460px; style: Theme.label; color: Theme.text-soft; overflow: elide; text: root.tokens_add_result; }
        Rectangle {
            x: 20px;
            y: 632px;
            width: parent.width - 40px;
            height: 26px;
            SmallOutlineButton {
                x: 0;
                y: 0;
                width: 150px;
                text: "Buy relay credit";
                clicked => { root.tokens_buy(); }
            }
            Label { x: 160px; height: 26px; style: Theme.small; color: Theme.faint; text: "Prepaid, anonymous, no account. Paste the code above."; }
        }

        // Config file editing
        Rectangle {
            x: 20px;
            y: 664px;
            width: parent.width - 40px;
            height: 26px;
            SmallOutlineButton {
                x: 0;
                y: 0;
                width: 150px;
                text: "Edit config file";
                clicked => { root.open_config(); }
            }
            Label { x: 160px; height: 26px; style: Theme.small; color: Theme.faint; text: "All settings, with defaults. Changes apply at the next start."; }
        }
        }

        SmallOutlineButton {
            x: settings.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.settings_visible = false; }
        }
    }

    // Feedback: stars and a message to the KeibiDrop inbox, no mail app needed
    if root.feedback_visible: feedback := Overlay {
        visible: !root.capturing;
        card-width: 460px;
        card-height: 400px;
        card-x: (root.width - 460px) / 2;
        card-y: (root.height - 400px) / 2;
        dismiss => { root.feedback_visible = false; }

        SmallOutlineButton {
            x: feedback.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.feedback_visible = false; }
        }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Report problem"; }

        // Five stars. Click one to rate, click it again to clear.
        for i in [1, 2, 3, 4, 5]: Rectangle {
            x: 20px + (i - 1) * 30px;
            y: 42px;
            width: 28px;
            height: 28px;
            Text {
                text: i <= root.feedback_rating ? "\u{2605}" : "\u{2606}";
                color: i <= root.feedback_rating ? Theme.accent : (star-touch.has-hover ? Theme.text : Theme.faint);
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            star-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.feedback_rating = root.feedback_rating == i ? 0 : i; }
            }
        }
        Label {
            x: 178px;
            y: 42px;
            height: 28px;
            style: Theme.caption;
            color: Theme.faint;
            text: root.feedback_rating == 0 ? "How is it going? Optional." : root.feedback_rating + " of 5";
        }

        Label { x: 20px; y: 78px; height: 16px; style: Theme.label; color: Theme.muted; text: "What happened? What did you expect instead?"; }

        TextEdit {
            x: 20px;
            y: 100px;
            width: feedback.card-width - 40px;
            height: 144px;
            font-size: 13px;
            wrap: word-wrap;
            text <=> root.feedback_message;
        }

        LineEdit {
            x: 20px;
            y: 254px;
            width: feedback.card-width - 40px;
            height: 30px;
            font-size: 13px;
            placeholder-text: "Email for a reply (optional)";
            text <=> root.feedback_contact;
        }

        Label {
            x: 20px;
            y: 292px;
            width: feedback.card-width - 40px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.hint;
            color: Theme.faint;
            text: "Sends your stars, your message, the reply address, the app version and the platform. Nothing else.";
        }

        PillButton {
            x: 20px;
            y: 336px;
            width: 120px;
            text: root.feedback_sending ? "Sending..." : "Send";
            enabled: !root.feedback_sending && root.feedback_message != "";
            clicked => { root.send_feedback(root.feedback_message, root.feedback_contact, root.feedback_rating); }
        }

        SmallOutlineButton {
            x: 152px;
            y: 341px;
            text: "Cancel";
            clicked => { root.feedback_visible = false; }
        }
    }

    // Save Contact dialog
    if root.save_contact_visible: save-contact := Overlay {
        visible: !root.capturing;
        card-width: 360px;
        card-height: 160px;
        card-x: (root.width - 360px) / 2;
        card-y: (root.height - 160px) / 2;
        dismiss => { root.save_contact_visible = false; root.save_contact_name = ""; }

        SmallOutlineButton {
            x: save-contact.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.save_contact_visible = false; root.save_contact_name = ""; }
        }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Save Peer as Contact"; }
        Label { x: 20px; y: 50px; height: 14px; style: Theme.small; color: Theme.muted; text: "Name"; }

        Outline {
            x: 20px;
            y: 68px;
            width: save-contact.card-width - 40px;
            height: 32px;
            background: Theme.field;

            contact-name-input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                color: Theme.text;
                font-size: Theme.label.size;
                vertical-alignment: center;
                single-line: true;
                text <=> root.save_contact_name;
                accepted => {
                    if root.save_contact_name != "" {
                        root.save-peer-as-contact(root.save_contact_name);
                        root.save_contact_visible = false;
                        root.save_contact_name = "";
                    }
                }
            }
        }

        PillButton {
            x: 20px;
            y: 114px;
            width: save-contact.card-width - 40px;
            text: "Save";
            enabled: root.save_contact_name != "";
            clicked => {
                if root.save_contact_name != "" {
                    root.save-peer-as-contact(root.save_contact_name);
                    root.save_contact_visible = false;
                    root.save_contact_name = "";
                }
            }
        }
    }

    // FUSE offer (after the first received file)
    if root.fuse_offer_visible: fuse-offer := Overlay {
        visible: !root.capturing;
        card-width: 380px;
        card-height: 190px;
        card-x: (root.width - 380px) / 2;
        card-y: (root.height - 190px) / 2;
        dismiss => { root.fuse_offer_declined(); }

        SmallOutlineButton {
            x: fuse-offer.card-width - 36px;
            y: 8px;
            width: 24px;
            text: "X";
            clicked => { root.fuse_offer_declined(); }
        }

        Label { x: 20px; y: 16px; height: 20px; style: Theme.heading-medium; text: "Files as a folder"; }

        Label {
            x: 20px;
            y: 50px;
            width: fuse-offer.card-width - 40px;
            wrap: word-wrap;
            vertical-alignment: top;
            style: Theme.label;
            color: Theme.text-soft;
            text: root.fuse_offer_body;
        }

        PillButton {
            x: 20px;
            y: 138px;
            width: 200px;
            text: root.fuse_offer_action;
            clicked => { root.fuse_offer_accepted(); }
        }

        SmallOutlineButton {
            x: 240px;
            y: 143px;
            width: 90px;
            text: "Not now";
            clicked => { root.fuse_offer_declined(); }
        }
    }

    // ============ GLOBAL: header, drawn above the overlays ============

    KeibiDropLogo {
        x: 115px;
        y: root.current_screen == 0 || root.overlay_open ? 70.39px : 24px;
        visible: !root.capturing;
    }

    // Control pill (Figma Screen 12): Report problem, ?, ..., X.
    Glass {
        kind: GlassKind.pill;
        x: 868px;
        y: 76px;
        width: 161px;
        height: 24px;
        visible: !root.capturing;

        TextAction {
            x: 51px - self.width / 2;
            height: 24px;
            text: "Report problem";
            ink: root.feedback_visible ? Theme.text : Theme.muted;
            clicked => { root.show_overlay(false, !root.feedback_visible, false); }
        }
        TextAction {
            x: 103.5px - self.width / 2;
            height: 24px;
            pad: 5px;
            style: Theme.caption;
            text: "?";
            accessible-label: "Help";
            ink: root.help_visible ? Theme.text : Theme.muted;
            clicked => { root.show_overlay(!root.help_visible, false, false); }
        }
        TextAction {
            x: 126px - self.width / 2;
            y: -4px;
            height: 24px;
            pad: 4px;
            text: "...";
            accessible-label: "Menu";
            ink: root.menu_open ? Theme.text : Theme.muted;
            clicked => { root.menu_open = !root.menu_open; }
        }
        Rectangle {
            x: 141px;
            y: 6px;
            width: 13.004px;
            height: 13.004px;
            accessible-role: button;
            accessible-label: root.overlay_open ? "Close" : "Quit";
            accessible-action-default => { root.close_or_quit(); }
            Image {
                x: 2.17px;
                y: 2.17px;
                width: 8.668px;
                height: 8.667px;
                source: @image-url("../assets/xmark.svg");
                colorize: x-touch.has-hover ? Theme.text : Theme.muted;
            }
            x-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close_or_quit(); }
            }
        }
    }

    // A click anywhere else closes the menu.
    if root.menu_open: TouchArea {
        clicked => { root.menu_open = false; }
    }
    if root.menu_open: Glass {
        x: 868px;
        y: 108px;
        width: 161px;
        height: 35px + (root.menu_entries.length - 1) * 21px;
        visible: !root.capturing;
        for entry[i] in root.menu_entries: MenuItem {
            y: 4.5px + i * 21px;
            chevron-y: 10.35px + floor(i * 20.5 + 0.25) * 1px - self.y;
            width: parent.width;
            entry: entry;
            clicked => { root.menu_pick(entry.id); }
        }
    }

    // Toast notification (bottom-center, all screens)
    if root.toast_message != "": Glass {
        kind: GlassKind.pill;
        x: (parent.width - 280px) / 2;
        y: parent.height - 56px;
        width: 280px;
        height: 32px;
        visible: !root.capturing;

        Label {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            style: Theme.label;
            color: Theme.text;
            text: root.toast_message;
        }
    }

    // Version text bottom-right (all screens)
    Label {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 12px;
        style: Theme.caption;
        color: Theme.faint;
        text: root.version_text;
    }

    // Update notice bottom-left (all screens), set when a newer release exists
    if root.update_available != "": upd-touch := TouchArea {
        x: 16px;
        y: parent.height - 34px;
        width: upd-note.width;
        height: 22px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Update notice";
        accessible-action-default => { root.open_update_page(); }
        clicked => { root.open_update_page(); }
        upd-note := Label {
            height: 22px;
            style: Theme.caption;
            color: upd-touch.has-hover ? Theme.text : Theme.accent;
            text: "Version " + root.update_available + " is out. Click to get it.";
        }
    }
}

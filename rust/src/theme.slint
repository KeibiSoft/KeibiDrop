export component Label inherits Text {
    in property <TextStyle> style: Theme.small;
    // Text inside a button: the button carries the accessible label.
    in property <bool> silent: false;
    accessible-label: root.silent ? "" : root.text;
    font-size: root.style.size;
    font-weight: root.style.weight;
    letter-spacing: root.style.spacing;
    line-height-factor: root.style.leading;
    color: Theme.text;
    vertical-alignment: center;
}

// pill: 24px controls, track: switches (lit from below), panel: menus and
// lists, card: an overlay's frosted card.
export enum GlassKind { pill, track, panel, card }

struct RimBand { y: length, outer: color, inner: color }

// The light of her GLASS effect along a box's top and bottom edges: two
// hairlines that fade out within 4px of each edge, so the sides stay dark.
// It is drawn in clipped 1px bands, not with a gradient border, which the
// software renderer draws as one solid color.
component Rim inherits Rectangle {
    in property <length> radius: Theme.radius;
    // White alpha of the outer and inner hairline along each edge.
    in property <float> top-outer;
    in property <float> top-inner;
    in property <float> bottom-outer;
    in property <float> bottom-inner;

    property <length> h: max(root.height, 20px);
    property <[RimBand]> rim: [
        { y: 0, outer: rgba(255, 255, 255, root.top-outer), inner: rgba(255, 255, 255, root.top-inner) },
        { y: 1px, outer: rgba(255, 255, 255, root.top-outer * 0.73), inner: rgba(255, 255, 255, root.top-inner * 0.7) },
        { y: 2px, outer: rgba(255, 255, 255, root.top-outer * 0.45), inner: rgba(255, 255, 255, root.top-inner * 0.4) },
        { y: 3px, outer: rgba(255, 255, 255, root.top-outer * 0.16), inner: rgba(255, 255, 255, root.top-inner * 0.15) },
        { y: root.h - 4px, outer: rgba(255, 255, 255, root.bottom-outer * 0.15), inner: rgba(255, 255, 255, root.bottom-inner * 0.16) },
        { y: root.h - 3px, outer: rgba(255, 255, 255, root.bottom-outer * 0.45), inner: rgba(255, 255, 255, root.bottom-inner * 0.41) },
        { y: root.h - 2px, outer: rgba(255, 255, 255, root.bottom-outer * 0.74), inner: rgba(255, 255, 255, root.bottom-inner * 0.73) },
        { y: root.h - 1px, outer: rgba(255, 255, 255, root.bottom-outer), inner: rgba(255, 255, 255, root.bottom-inner) },
    ];

    for band in root.rim: Rectangle {
        y: band.y;
        height: 1px;
        clip: true;
        Rectangle {
            y: -band.y;
            height: root.height;
            border-radius: root.radius;
            border-width: Theme.hairline;
            border-color: band.outer;
        }
        Rectangle {
            x: Theme.hairline;
            y: Theme.hairline - band.y;
            width: root.width - 2 * Theme.hairline;
            height: root.height - 2 * Theme.hairline;
            border-radius: root.radius - Theme.hairline;
            border-width: Theme.hairline;
            border-color: band.inner;
        }
    }
}

// Figma GLASS effect, fitted to its 2x render: tint, light from the top edge,
// shade toward the bottom edge, and her rim.
export component Glass inherits Rectangle {
    in property <GlassKind> kind: GlassKind.panel;
    // Show the blurred window through the glass (cards over an overlay).
    in property <bool> frosted: false;
    // Her glass is grey; a switch that is on and the Teleport note are tinted.
    in property <color> tint: Theme.glass-tint;

    property <length> h: max(root.height, 20px);
    property <bool> track: root.kind == GlassKind.track;

    // Gradient stop at a distance from the top edge.
    pure function at(d: length) -> float {
        return d / root.h;
    }

    border-radius: Theme.radius;
    clip: true;

    if root.frosted: Image {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: Backdrop.width;
        height: Backdrop.height;
        source: Backdrop.blur;
        image-fit: fill;
    }
    // A card repeats the overlay's tint over the blur it shows. Every layer is
    // rounded itself: the software renderer clips to the bounding rectangle.
    if root.frosted: Rectangle { border-radius: Theme.radius; background: Theme.glass-tint; }
    Rectangle {
        border-radius: Theme.radius;
        background: root.tint;
        animate background { duration: 150ms; }
    }
    Rectangle {
        border-radius: Theme.radius;
        background: root.kind == GlassKind.pill
            ? @linear-gradient(180deg, #ffffff09 0%, #ffffff07 root.at(2px), #ffffff04 root.at(4px), #ffffff00 root.at(9.5px))
            : root.track
            ? @linear-gradient(180deg, #ffffff00 root.at(11px), #ffffff02 root.at(14px), #ffffff03 root.at(15px), #ffffff05 root.at(17px), #ffffff09 root.at(18.5px), #ffffff0a 100%)
            : root.kind == GlassKind.panel
            ? @linear-gradient(180deg, #ffffff08 0%, #ffffff04 root.at(8px), #ffffff02 root.at(16px), #ffffff00 root.at(32px))
            : @linear-gradient(180deg, #ffffff0d 0%, #ffffff0c root.at(5px), #ffffff0b root.at(13px), #ffffff08 root.at(25px), #ffffff0a root.at(45px), #ffffff08 root.at(57px), #ffffff07 root.at(73px), #ffffff04 root.at(89px), #ffffff01 root.at(113px), #ffffff01 100%);
    }
    Rectangle {
        border-radius: Theme.radius;
        background: root.kind == GlassKind.pill
            ? @linear-gradient(180deg, #00000000 0%, #00000004 root.at(9.5px), #00000004 root.at(root.h - 10px), #00000016 root.at(root.h - 6px), #0000003a root.at(root.h - 1.5px), #00000040 100%)
            : root.track
            ? @linear-gradient(180deg, #0000002d 0%, #00000026 root.at(3px), #00000018 root.at(4px), #00000012 root.at(5px), #0000000b root.at(6px), #0000000b root.at(9px), #00000004 root.at(10px), #00000000 root.at(11px))
            : root.kind == GlassKind.panel
            ? @linear-gradient(180deg, #00000000 root.at(32px), #0000000b root.at(40px), #0000000b root.at(root.h - 17px), #00000018 root.at(root.h - 13px), #0000002d root.at(root.h - 1.5px), #0000002e 100%)
            : @linear-gradient(180deg, #00000000 root.at(root.h - 140px), #00000001 root.at(root.h - 91px), #00000005 root.at(root.h - 75px), #0000000b root.at(root.h - 51px), #0000001a root.at(root.h - 31px), #0000001d root.at(root.h - 15px), #00000023 100%);
    }
    Rim {
        radius: Theme.radius;
        top-outer: root.track ? 0.53 : 0.44;
        top-inner: root.track ? 0.33 : 0.13;
        bottom-outer: root.track ? 0.36 : 0.68;
        bottom-inner: root.track ? 0.21 : 0.19;
    }
    @children
}

// card: her step cards; badge: their numbers; panel: the menu pill and its
// menu; list: contacts; field, button, button-dim: a code and its buttons;
// primary: Connect; highlight: a nearby device (Figma NEW 2.0).
export enum BoxKind { card, badge, panel, list, field, button, button-dim, primary, highlight }

// Her box (NEW 2.0): a fill, a line and, on cards and the pill, the light of
// her glass along the top and bottom edges. The box is her vector's outline:
// the line runs centred on it, half outside, except a highlight's 1px line,
// which runs inside.
export component Box inherits Rectangle {
    in property <BoxKind> kind: BoxKind.card;
    in property <brush> fill: root.kind == BoxKind.card ? root.box-fill(0.2)
        : root.kind == BoxKind.panel ? root.box-fill(0.5)
        : root.kind == BoxKind.list ? root.box-fill(1)
        : root.kind == BoxKind.badge ? Theme.badge-fill
        : root.kind == BoxKind.field ? Theme.field
        : root.kind == BoxKind.button ? Theme.button
        : root.kind == BoxKind.button-dim ? Theme.button-dim
        : root.kind == BoxKind.primary ? Theme.primary-fill
        : transparent;
    in property <brush> line: root.kind == BoxKind.card || root.kind == BoxKind.panel ? Theme.box-line
        : root.kind == BoxKind.list ? Theme.list-line
        : root.kind == BoxKind.badge ? Theme.badge-line
        : root.kind == BoxKind.field ? Theme.field-line
        : root.kind == BoxKind.button ? Theme.button-line
        : root.kind == BoxKind.button-dim ? Theme.button-dim-line
        : root.kind == BoxKind.highlight ? Theme.highlight
        : transparent;
    in property <length> radius: root.kind == BoxKind.card || root.kind == BoxKind.badge ? Theme.radius-card
        : root.kind == BoxKind.panel ? Theme.radius-panel
        : root.kind == BoxKind.list ? Theme.radius-list
        : root.kind == BoxKind.field ? Theme.radius-field
        : Theme.radius-button;

    property <bool> lit: root.kind == BoxKind.card || root.kind == BoxKind.badge || root.kind == BoxKind.panel;
    property <length> line-width: root.kind == BoxKind.primary ? 0 : root.kind == BoxKind.highlight ? 1px : Theme.line;
    // How far the drawing reaches past the box.
    out property <length> out: root.kind == BoxKind.highlight ? 0 : root.line-width / 2;
    out property <length> outer-radius: root.radius + root.out;

    // Her fill: the gradient at a strength.
    pure function box-fill(alpha: float) -> brush {
        return @linear-gradient(90deg, Theme.box-from.with-alpha(alpha) 0%, Theme.box-to.with-alpha(alpha) 100%);
    }

    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        background: root.fill;
    }
    if root.lit: Rim {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        radius: root.outer-radius;
        top-outer: root.kind == BoxKind.panel ? 0.36 : 0.5;
        top-inner: root.kind == BoxKind.panel ? 0.1 : 0.36;
        bottom-outer: root.kind == BoxKind.panel ? 0.26 : 0.36;
        bottom-inner: root.kind == BoxKind.panel ? 0.1 : 0.24;
    }
    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        border-width: root.line-width;
        border-color: root.line;
    }
    @children
}

// Her line (NEW 2.0) drawn as a filled box, at least one screen pixel thick:
// the GPU renderer drops a box thinner than a pixel on a 1x screen. x (for a
// vertical line) or y (a horizontal one) is the line's centre; the other
// size is its length.
export component Rule inherits Rectangle {
    in property <bool> vertical: false;
    in property <brush> ink: Theme.divider;
    property <length> thickness: max(Theme.line, 1phx);

    Rectangle {
        x: root.vertical ? -root.thickness / 2 : 0;
        y: root.vertical ? 0 : -root.thickness / 2;
        width: root.vertical ? root.thickness : root.width;
        height: root.vertical ? root.height : root.thickness;
        background: root.ink;
    }
}

// Her background (NEW 2.0): light from above the middle of the top edge
// fading to near black at the bottom, her SVG stretched with the window.
export component Background inherits Image {
    source: @image-url("../assets/background.svg");
    image-fit: fill;
}

// A pill with a centred label (Figma 214:988 "< Back"): Light 10px white,
// in her NEW 2.0 pill. It lights up a little on hover and press.
export component GlassButton inherits Box {
    in property <string> text;
    callback clicked;

    kind: BoxKind.panel;
    height: 24px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: -root.out;
        y: -root.out;
        width: root.width + 2 * root.out;
        height: root.height + 2 * root.out;
        border-radius: root.outer-radius;
        background: touch.pressed ? #ffffff14 : touch.has-hover ? #ffffff0a : transparent;
        animate background { duration: 150ms; }
    }
    // Figma draws her label half a pixel right of and below the centre.
    Label {
        x: 0.5px;
        y: 0.5px;
        width: root.width;
        height: root.height;
        horizontal-alignment: center;
        silent: true;
        text: root.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One of her icons (Icons) at its own size: round strokes, white by default.
export component Icon inherits Rectangle {
    in property <string> icon;
    in property <length> line: 1px;
    in property <color> ink: Theme.text;
    // Her dots are filled.
    in property <bool> filled: false;

    Path {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        fit: preserve;
        commands: root.icon;
        stroke: root.ink;
        stroke-width: root.line;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.ink : transparent;
    }
}

// An icon that is a button (her pill, her cards' close): grey, white on hover;
// her NEW 2.0 pill draws them white, blue on hover. The hit area reaches pad
// past the icon.
export component IconButton inherits Icon {
    in property <length> pad: 6px;
    in property <color> rest-ink: Theme.muted;
    in property <color> hover-ink: Theme.text;
    callback clicked;

    line: 1.5px;
    ink: touch.has-hover || touch.pressed ? root.hover-ink : root.rest-ink;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        x: -root.pad;
        y: -root.pad;
        width: root.width + 2 * root.pad;
        height: root.height + 2 * root.pad;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Her ring (Figma component set "Spinner"): a track at 25% around the box's
// centre. Spinner and ProgressRing draw their arc on it.
export component Ring inherits Rectangle {
    // Centre line of the track. Her big ring is a hair taller than wide.
    in property <length> radius-x: 6.579px;
    in property <length> radius-y: self.radius-x;
    in property <length> thickness: 5px;

    out property <float> cx: root.width / 1px / 2;
    out property <float> cy: root.height / 1px / 2;
    out property <float> rx: root.radius-x / 1px;
    out property <float> ry: root.radius-y / 1px;

    // A point on the track, clockwise from 12 o'clock, in path units (px).
    public pure function at(a: angle) -> string {
        return (root.cx + root.rx * sin(a)) + " " + (root.cy - root.ry * cos(a));
    }
    // The track clockwise from the last point to a, under half a turn.
    public pure function to(a: angle) -> string {
        return " A " + root.rx + " " + root.ry + " 0 0 1 " + root.at(a);
    }

    Path {
        width: root.width;
        height: root.height;
        fit: preserve;
        commands: "M " + root.at(0deg) + root.to(90deg) + root.to(180deg) + root.to(270deg) + root.to(360deg) + " Z";
        stroke: Theme.spinner-track;
        stroke-width: root.thickness;
        fill: transparent;
    }
}

// Her spinner: a quarter arc with a round head that fades out behind it. Her
// prototype turns it a quarter clockwise per step, linear, and comes to rest
// where it began; set active, it turns until let go, then ends the turn it is
// in. Her arcs are dashed 4/4, but the round caps close the gaps, so the arc
// is drawn whole. It is redrawn each frame because not every renderer rotates.
export component Spinner inherits Ring {
    in property <bool> active: false;
    // Where the head rests, clockwise from 12 o'clock.
    in property <angle> head: 0deg;
    // Off: at rest only the track shows, the arc comes with the turn.
    in property <bool> arc-at-rest: true;

    // True from a start until the end of the turn it was let go in.
    out property <bool> turning: false;
    property <duration> began;
    property <float> turn: Theme.spin / 1ms;
    property <float> t: root.turning ? mod((animation-tick() - root.began) / 1ms, root.turn) : 0;
    // Her steps: three quarters of 200 ms, the last of 300 ms (Theme.spin is 900).
    property <angle> tip: root.head + 1deg * (root.t < root.turn * 2 / 3
        ? root.t * 405 / root.turn
        : 270 + (root.t - root.turn * 2 / 3) * 270 / root.turn);

    function start() {
        root.began = animation-tick();
        root.turning = true;
    }
    init => {
        if (root.active) {
            root.start();
        }
    }
    changed active => {
        if (root.active && !root.turning) {
            root.start();
        }
    }
    // Whole turns only: stop at the end of the turn in which it was let go.
    Timer {
        interval: Theme.spin;
        running: root.turning;
        triggered => {
            if (!root.active) {
                root.turning = false;
            }
        }
    }

    Path {
        // Her gradient crosses the centre, opaque just past the head and clear
        // on the far side, 1% at 75.5% of the way. Slint measures a gradient
        // across the whole box (CSS), so the stops follow the angle.
        property <angle> a: root.tip + 210.2deg;
        property <float> k: (root.rx + root.ry) / 2
            / ((abs(root.width * sin(self.a)) + abs(root.height * cos(self.a))) / 1px);
        property <float> t0: 0.5 - self.k;
        property <float> t1: 0.5 + 0.5104 * self.k;
        property <float> t2: 0.5 + self.k;
        property <color> fade: Theme.progress.transparentize(0.99);
        property <color> clear: Theme.progress.transparentize(1);

        visible: root.turning || root.arc-at-rest;
        width: root.width;
        height: root.height;
        fit: preserve;
        commands: "M " + root.at(root.tip - 90deg) + root.to(root.tip);
        stroke: @linear-gradient(self.a, Theme.progress self.t0, self.fade self.t1, self.clear self.t2);
        stroke-width: root.thickness;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// A download's progress on her ring: the arc grows clockwise from 12 o'clock
// in her blue, a dot at the start.
export component ProgressRing inherits Ring {
    in property <float> progress: 0.0; // 0.0 to 1.0

    Path {
        property <angle> sweep: clamp(root.progress, 0.01, 0.999) * 360deg;

        width: root.width;
        height: root.height;
        fit: preserve;
        commands: "M " + root.at(0deg)
            + (self.sweep > 180deg ? root.to(180deg) + root.to(self.sweep) : root.to(self.sweep));
        stroke: Theme.progress;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        fill: transparent;
    }
}

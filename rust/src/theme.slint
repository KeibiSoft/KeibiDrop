// Design tokens and primitives from Mila's Figma file (KEIBIDROP, Screens 12
// and 13). Every color, size and type style of the UI comes from here.

// Inter 3.19, the version Figma renders with (text widths match it, not 4.x).
import "../assets/fonts/Inter.ttf";

export struct TextStyle {
    size: length,
    weight: int,
    spacing: length,
    // Line height as a factor of Inter's natural 1.21 em.
    leading: float,
}

export global Theme {
    // Surfaces
    out property <color> window: #222222;
    // Window base under an overlay's blur (Screen 13 frame).
    out property <color> window-dim: #1c1c1c;
    out property <color> card: #262626;
    out property <color> field: #222222;
    out property <color> outline: #ffffff;
    out property <color> button: #888888;
    out property <color> knob-on: #ffffff;
    out property <color> knob-off: #888888;
    out property <color> progress: #1681ff;
    out property <color> progress-track: #1f3a59;
    out property <color> file-preview: #454545;
    out property <color> scrollbar: #888888;
    out property <color> glass-tint: rgba(52, 52, 54, 0.2);

    // Text
    out property <color> text: #ffffff;
    out property <color> text-soft: rgba(255, 255, 255, 0.5);
    out property <color> muted: #888888;
    out property <color> faint: #6a6a6a;
    out property <color> on-button: #262626;
    out property <color> accent: #177cf3;
    out property <color> accent-line: #177df5;
    out property <color> link: #1583ff;
    out property <color> online: #0885fe;
    out property <color> offline: #878787;
    out property <color> error: #c74309;

    // Geometry
    out property <length> radius: 7px;
    out property <length> radius-small: 5px;
    out property <length> hairline: 0.5px;
    out property <length> control: 34px;

    // Type
    out property <TextStyle> title: { size: 23px, weight: 800, spacing: -0.48px, leading: 1 };
    out property <TextStyle> title-wide: { size: 23px, weight: 800, spacing: 1px, leading: 1 };
    out property <TextStyle> title-light: { size: 23px, weight: 200, spacing: 1px, leading: 1 };
    out property <TextStyle> subtitle: { size: 14px, weight: 200, spacing: 1px, leading: 1 };
    out property <TextStyle> heading: { size: 16px, weight: 400, spacing: -0.48px, leading: 1 };
    out property <TextStyle> heading-medium: { size: 16px, weight: 500, spacing: -0.48px, leading: 1 };
    out property <TextStyle> section: { size: 16px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> code: { size: 15px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> primary: { size: 15px, weight: 800, spacing: 0, leading: 1 };
    out property <TextStyle> button-label: { size: 14px, weight: 800, spacing: 0, leading: 1 };
    out property <TextStyle> label: { size: 12px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> badge: { size: 11px, weight: 400, spacing: -0.22px, leading: 1 };
    out property <TextStyle> caption: { size: 11px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> small: { size: 10px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> small-strong: { size: 10px, weight: 600, spacing: 0, leading: 1 };
    out property <TextStyle> note: { size: 10px, weight: 500, spacing: 0, leading: 1 };
    out property <TextStyle> hint: { size: 10px, weight: 400, spacing: -0.2px, leading: 1.157 };
    out property <TextStyle> tiny: { size: 8px, weight: 300, spacing: 0, leading: 1.033 };
    out property <TextStyle> tiny-strong: { size: 8px, weight: 500, spacing: -0.16px, leading: 1.033 };
}

// The window behind an open overlay, blurred off the UI thread (lib.rs).
export global Backdrop {
    in-out property <image> blur;   // Figma background blur 32
    in-out property <length> width;
    in-out property <length> height;
}

export component Label inherits Text {
    in property <TextStyle> style: Theme.small;
    // Text inside a button: the button carries the accessible label.
    in property <bool> silent: false;
    accessible-label: root.silent ? "" : root.text;
    font-size: root.style.size;
    font-weight: root.style.weight;
    letter-spacing: root.style.spacing;
    line-height-factor: root.style.leading;
    color: Theme.text;
    vertical-alignment: center;
}

// pill: 24px controls, track: switches (lit from below), panel: menus and
// lists, card: an overlay's frosted card.
export enum GlassKind { pill, track, panel, card }

struct RimBand { y: length, outer: color, inner: color }

// Figma GLASS effect, fitted to its 2x render: tint, light from the top edge,
// shade toward the bottom edge, and a rim of two hairlines that fades out
// within 4px of both edges. The rim is drawn in clipped 1px bands, not with a
// gradient border, which the software renderer draws as one solid color.
export component Glass inherits Rectangle {
    in property <GlassKind> kind: GlassKind.panel;
    // Show the blurred window through the glass (cards over an overlay).
    in property <bool> frosted: false;

    property <length> h: max(root.height, 20px);
    property <bool> track: root.kind == GlassKind.track;
    // Rim strength (white alpha) of the outer and inner hairline per edge.
    property <float> top-outer: root.track ? 0.53 : 0.44;
    property <float> top-inner: root.track ? 0.33 : 0.13;
    property <float> bottom-outer: root.track ? 0.36 : 0.68;
    property <float> bottom-inner: root.track ? 0.21 : 0.19;
    property <[RimBand]> rim: [
        { y: 0, outer: rgba(255, 255, 255, root.top-outer), inner: rgba(255, 255, 255, root.top-inner) },
        { y: 1px, outer: rgba(255, 255, 255, root.top-outer * 0.73), inner: rgba(255, 255, 255, root.top-inner * 0.7) },
        { y: 2px, outer: rgba(255, 255, 255, root.top-outer * 0.45), inner: rgba(255, 255, 255, root.top-inner * 0.4) },
        { y: 3px, outer: rgba(255, 255, 255, root.top-outer * 0.16), inner: rgba(255, 255, 255, root.top-inner * 0.15) },
        { y: root.h - 4px, outer: rgba(255, 255, 255, root.bottom-outer * 0.15), inner: rgba(255, 255, 255, root.bottom-inner * 0.16) },
        { y: root.h - 3px, outer: rgba(255, 255, 255, root.bottom-outer * 0.45), inner: rgba(255, 255, 255, root.bottom-inner * 0.41) },
        { y: root.h - 2px, outer: rgba(255, 255, 255, root.bottom-outer * 0.74), inner: rgba(255, 255, 255, root.bottom-inner * 0.73) },
        { y: root.h - 1px, outer: rgba(255, 255, 255, root.bottom-outer), inner: rgba(255, 255, 255, root.bottom-inner) },
    ];

    // Gradient stop at a distance from the top edge.
    pure function at(d: length) -> float {
        return d / root.h;
    }

    border-radius: Theme.radius;
    clip: true;

    if root.frosted: Image {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: Backdrop.width;
        height: Backdrop.height;
        source: Backdrop.blur;
        image-fit: fill;
    }
    // A card repeats the overlay's tint over the blur it shows. Every layer is
    // rounded itself: the software renderer clips to the bounding rectangle.
    if root.frosted: Rectangle { border-radius: Theme.radius; background: Theme.glass-tint; }
    Rectangle { border-radius: Theme.radius; background: Theme.glass-tint; }
    Rectangle {
        border-radius: Theme.radius;
        background: root.kind == GlassKind.pill
            ? @linear-gradient(180deg, #ffffff09 0%, #ffffff07 root.at(2px), #ffffff04 root.at(4px), #ffffff00 root.at(9.5px))
            : root.track
            ? @linear-gradient(180deg, #ffffff00 root.at(11px), #ffffff02 root.at(14px), #ffffff03 root.at(15px), #ffffff05 root.at(17px), #ffffff09 root.at(18.5px), #ffffff0a 100%)
            : root.kind == GlassKind.panel
            ? @linear-gradient(180deg, #ffffff08 0%, #ffffff04 root.at(8px), #ffffff02 root.at(16px), #ffffff00 root.at(32px))
            : @linear-gradient(180deg, #ffffff0d 0%, #ffffff0c root.at(5px), #ffffff0b root.at(13px), #ffffff08 root.at(25px), #ffffff0a root.at(45px), #ffffff08 root.at(57px), #ffffff07 root.at(73px), #ffffff04 root.at(89px), #ffffff01 root.at(113px), #ffffff01 100%);
    }
    Rectangle {
        border-radius: Theme.radius;
        background: root.kind == GlassKind.pill
            ? @linear-gradient(180deg, #00000000 0%, #00000004 root.at(9.5px), #00000004 root.at(root.h - 10px), #00000016 root.at(root.h - 6px), #0000003a root.at(root.h - 1.5px), #00000040 100%)
            : root.track
            ? @linear-gradient(180deg, #0000002d 0%, #00000026 root.at(3px), #00000018 root.at(4px), #00000012 root.at(5px), #0000000b root.at(6px), #0000000b root.at(9px), #00000004 root.at(10px), #00000000 root.at(11px))
            : root.kind == GlassKind.panel
            ? @linear-gradient(180deg, #00000000 root.at(32px), #0000000b root.at(40px), #0000000b root.at(root.h - 17px), #00000018 root.at(root.h - 13px), #0000002d root.at(root.h - 1.5px), #0000002e 100%)
            : @linear-gradient(180deg, #00000000 root.at(root.h - 140px), #00000001 root.at(root.h - 91px), #00000005 root.at(root.h - 75px), #0000000b root.at(root.h - 51px), #0000001a root.at(root.h - 31px), #0000001d root.at(root.h - 15px), #00000023 100%);
    }
    for band in root.rim: Rectangle {
        y: band.y;
        height: 1px;
        clip: true;
        Rectangle {
            y: -band.y;
            height: root.height;
            border-radius: Theme.radius;
            border-width: Theme.hairline;
            border-color: band.outer;
        }
        Rectangle {
            x: Theme.hairline;
            y: Theme.hairline - band.y;
            width: root.width - 2 * Theme.hairline;
            height: root.height - 2 * Theme.hairline;
            border-radius: Theme.radius - Theme.hairline;
            border-width: Theme.hairline;
            border-color: band.inner;
        }
    }
    @children
}

// 0.5px white outline, 7px corners: cards, badges, fields.
export component Outline inherits Rectangle {
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.outline;
}

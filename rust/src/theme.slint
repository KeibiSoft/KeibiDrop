    out property <string> play: "M 2 12.5 C 2 18.299 6.701 23 12.5 23 C 18.299 23 23 18.299 23 12.5 C 23 6.701 18.299 2 12.5 2 C 6.701 2 2 6.701 2 12.5 Z M 10.167 16 L 10.167 9 L 16 12.5 L 10.167 16 Z";
    out property <string> code: "M 17.125 2 L 24 9 L 17.125 16 M 8.875 16 L 2 9 L 8.875 2";
    out property <string> download: "M 14.067 3.094 L 17.862 6.74 C 18.282 7.144 18.491 7.345 18.641 7.58 C 18.774 7.789 18.873 8.017 18.932 8.255 C 18.982 8.456 18.995 8.667 18.999 9 C 19 9.112 19 9.237 19 9.38 L 19 19.271 C 19 20.575 19 21.227 18.735 21.726 C 18.502 22.165 18.13 22.522 17.673 22.746 C 17.154 23 16.475 23 15.118 23 L 5.882 23 C 4.524 23 3.845 23 3.326 22.746 C 2.869 22.522 2.498 22.165 2.265 21.726 C 2 21.227 2 20.574 2 19.267 L 2 5.734 C 2 4.427 2 3.773 2.265 3.274 C 2.498 2.835 2.869 2.478 3.326 2.254 C 3.845 2 4.526 2 5.886 2 L 11.319 2 C 11.468 2 11.598 2 11.714 2.001 C 12.061 2.004 12.28 2.016 12.49 2.064 C 12.738 2.122 12.974 2.216 13.192 2.344 C 13.437 2.488 13.647 2.69 14.067 3.094 Z M 10.5 12.5 L 10.5 19.5 M 10.5 19.5 L 14.143 17.167 M 10.5 19.5 L 6.857 17.167 M 11.714 2.001 L 11.714 5.267 C 11.714 6.573 11.714 7.226 11.979 7.726 C 12.212 8.165 12.583 8.522 13.04 8.746 C 13.559 9 14.239 9 15.596 9 L 18.999 9 L 19 9";

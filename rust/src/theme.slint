// Design tokens and primitives from the Figma file (KEIBIDROP, Screens 12
// to 14, and NEW 2.0: frames 271:778 and 273:1324, which set the colors).
// Every color, size, icon and type style of the UI comes from here.

// Inter 3.19, the version Figma renders with (text widths match it, not 4.x).
import "../assets/fonts/Inter.ttf";

export struct TextStyle {
    size: length,
    weight: int,
    spacing: length,
    // Line height as a factor of Inter's natural 1.21 em.
    leading: float,
}

export global Theme {
    // Surfaces. Her background (NEW 2.0) is a gradient on this color, see
    // Background.
    out property <color> window: #222222;
    // Window base under an overlay's blur (Screen 13 frame).
    out property <color> window-dim: #1c1c1c;
    // A name shown whole, a row under the pointer: her menu's fill over the
    // background.
    out property <color> card: #1a1d22;
    // Her boxes (NEW 2.0): a blue-grey gradient from left to right behind a
    // grey line. Cards show it at 20%, the pill and its menu at 50%, the
    // contact list whole.
    out property <color> box-from: #171d24;
    out property <color> box-to: #11161c;
    out property <color> box-line: rgba(76, 84, 94, 0.5);
    out property <color> list-line: #4c545e;
    out property <color> badge-fill: rgba(17, 22, 27, 0.2);
    out property <color> badge-line: rgba(85, 93, 103, 0.5);
    out property <color> field: rgba(17, 22, 27, 0.5);
    out property <color> field-line: #69717b;
    // Her grey buttons: Add is a shade lighter than Copy and Invite link.
    out property <color> button: #3b4046;
    out property <color> button-line: #858b92;
    out property <color> button-dim: #34393f;
    out property <color> button-dim-line: #6f7780;
    // Connect, and the line of a nearby device.
    out property <brush> primary-fill: @linear-gradient(90deg, #2687ff 0%, #0868f5 100%);
    out property <brush> highlight: @linear-gradient(90deg, #2485fe 0%, #0a6af6 100%);
    out property <color> divider: #343b43;
    out property <color> row-divider: #303740;
    // Switch (Figma Screen 12, her Incognito example): a grey knob on grey
    // glass when off, a blue knob on blue glass when on.
    out property <color> knob-on: #177cf3;
    out property <color> knob-off: #888888;
    out property <color> switch-on: rgba(23, 124, 243, 0.2);
    out property <color> switch-off: rgba(54, 52, 52, 0.2);
    out property <color> progress: #1681ff;
    // Her spinner's track: progress at 25%, so a file preview's grey shows
    // through it.
    out property <color> spinner-track: rgba(22, 129, 255, 0.25);
    out property <color> file-preview: #454545;
    out property <color> scrollbar: #888888;
    out property <color> glass-tint: rgba(52, 52, 54, 0.2);
    // Her background's veil (NEW 2.0): the glass overlays and the Teleport
    // screen lay it over the window they blur.
    out property <color> veil: rgba(13, 17, 22, 0.32);
    // The note under the Teleport card (Figma Screen 14).
    out property <color> info-tint: rgba(38, 46, 58, 0.2);

    // Text: her blue-greys (NEW 2.0).
    out property <color> text: #ffffff;
    // Headings, names and the labels of grey buttons.
    out property <color> text-strong: #f2f3f4;
    // A code in its field.
    out property <color> text-soft: #8f959d;
    out property <color> muted: #8c929b;
    out property <color> faint: #7f858e;
    // The version.
    out property <color> fainter: #737a83;
    out property <color> switch-ink: #e2e4e7;
    // The second line under a switch.
    out property <color> caption-ink: #7f8791;
    out property <color> step-ink: #d7d9dc;
    out property <color> chip-ink: #c8ccd1;
    out property <color> accent: #177cf3;
    out property <color> link: #2785ff;
    // Open on a file card (Figma 214:988).
    out property <color> open-ink: #1779ec;
    out property <color> online: #1677ff;
    out property <color> offline: #7b828a;
    out property <color> error: #c74309;

    // Geometry
    out property <length> radius: 7px;
    out property <length> radius-small: 5px;
    out property <length> hairline: 0.5px;
    // Her line (NEW 2.0), centred on a box's edge.
    out property <length> line: 0.793px;
    out property <length> control: 34px;
    // Her field and Connect.
    out property <length> field-height: 37.27px;
    out property <length> button-height: 39px;
    // Two buttons side by side in a dialog (Save contact, Report problem): the
    // main choice and the plain second choice share this width.
    out property <length> dialog-button-width: 155px;
    // Corners where her lines run. Her buttons and her pill have wider than
    // tall corners; these are the round corners closest to them.
    out property <length> radius-card: 9.516px;
    out property <length> radius-panel: 10.17px;
    out property <length> radius-list: 8.94px;
    out property <length> radius-field: 7.93px;
    out property <length> radius-button: 8.75px;
    // The Figma frame. A larger window centres this column.
    out property <length> frame-width: 1144px;
    out property <length> frame-height: 729px;
    // How far the UI scales with its window (main.rs first_size, fit_zoom):
    // it opens at no more than zoom-open, and shrinks to zoom-min so a small
    // screen still holds it.
    out property <float> zoom-open: 1.25;
    out property <float> zoom-min: 0.75;
    // The box every screen keeps inside: the logo's left edge and
    // top, the menu pill's right edge (Figma Screen 12).
    out property <length> box-left: 115px;
    out property <length> box-right: 1029px;
    out property <length> box-top: 70.39px;
    out property <length> box-width: self.box-right - self.box-left;
    // The menu pill, at one place on every screen, as wide as the right
    // column (NEW 2.0). Its top is the box's top: the logo and the pill
    // enclose everything (Marius). Its menu opens her 5.55px under it, her
    // rows 26.96px apart.
    out property <length> pill-y: self.box-top;
    out property <length> pill-width: 201.04px;
    out property <length> pill-height: 31.72px;
    out property <length> menu-y: self.pill-y + self.pill-height + 5.55px;
    out property <length> menu-row: 26.96px;

    // One turn of her spinner: her prototype steps a quarter in 200, 200, 200
    // and 300 ms (Figma component set "Spinner").
    out property <duration> spin: 900ms;

    // Type
    out property <TextStyle> title: { size: 23px, weight: 800, spacing: -0.48px, leading: 1 };
    out property <TextStyle> title-wide: { size: 23px, weight: 800, spacing: 1px, leading: 1 };
    out property <TextStyle> title-light: { size: 23px, weight: 200, spacing: 1px, leading: 1 };
    out property <TextStyle> subtitle: { size: 14px, weight: 200, spacing: 1px, leading: 1 };
    out property <TextStyle> heading: { size: 16px, weight: 400, spacing: -0.48px, leading: 1 };
    out property <TextStyle> heading-medium: { size: 16px, weight: 500, spacing: -0.48px, leading: 1 };
    out property <TextStyle> section: { size: 16px, weight: 400, spacing: 0, leading: 1 };
    // Connect (NEW 2.0).
    out property <TextStyle> primary: { size: 14px, weight: 700, spacing: 0, leading: 1 };
    out property <TextStyle> button-label: { size: 14px, weight: 800, spacing: 0, leading: 1 };
    out property <TextStyle> button-small: { size: 11px, weight: 800, spacing: 0, leading: 1 };
    out property <TextStyle> label: { size: 12px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> badge: { size: 11px, weight: 400, spacing: -0.22px, leading: 1 };
    out property <TextStyle> caption: { size: 11px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> small: { size: 10px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> small-strong: { size: 10px, weight: 600, spacing: 0, leading: 1 };
    out property <TextStyle> hint: { size: 10px, weight: 400, spacing: -0.2px, leading: 1.157 };
    out property <TextStyle> tiny: { size: 8px, weight: 300, spacing: 0, leading: 1.033 };
    // NEW 2.0 (Figma 271:778).
    out property <TextStyle> card-heading: { size: 15.859px, weight: 700, spacing: 0, leading: 1 };
    out property <TextStyle> list-heading: { size: 15.703px, weight: 700, spacing: 0, leading: 1 };
    out property <TextStyle> card-line: { size: 11.102px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> field-text: { size: 13.48px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> field-button: { size: 13.48px, weight: 700, spacing: 0, leading: 1 };
    out property <TextStyle> field-button-small: { size: 12.688px, weight: 700, spacing: 0, leading: 1 };
    out property <TextStyle> card-note: { size: 10.309px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> switch-label: { size: 12.688px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> switch-detail: { size: 9.516px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> step: { size: 11.895px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> menu: { size: 11.895px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> row: { size: 10.992px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> chip: { size: 10.207px, weight: 400, spacing: 0, leading: 1 };
    out property <TextStyle> device: { size: 14px, weight: 300, spacing: 0, leading: 1 };
    out property <TextStyle> device-action: { size: 14px, weight: 700, spacing: 0, leading: 1 };
}

// The window behind an open overlay, blurred off the UI thread (lib.rs).
export global Backdrop {
    in-out property <image> blur;   // Figma background blur 32
    // The connect screen behind the Teleport screen, blurred the same way.
    in-out property <image> screen;
    in-out property <length> width;
    in-out property <length> height;
}

// Her icons (Figma Screens 12 to 14) as path data in px, moved 2px right and
// down so the round caps stay inside the drawing (Icon).
